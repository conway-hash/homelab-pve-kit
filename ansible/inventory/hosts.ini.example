# Copy to inventory/hosts.ini (git-ignored). In CI this is generated at
# deploy time — see .github/workflows/deploy.yml.
#
# Two accounts exist on the Proxmox host on purpose:
#
#   claude    — no sudo at all, for read-only inspection. Not used here.
#   ci-deploy — NOPASSWD sudo, the only account that applies changes.
#
# A restricted-sudo whitelist was considered and rejected: `sudo cat` reads
# /etc/shadow and `sudo journalctl` can shell out through its pager, so a
# whitelist looks limited without being limited. No-sudo is a real
# boundary; a whitelist is a comfortable-feeling fake one.

[pve_host]
pve ansible_host=pve.ts.conway-hash.com ansible_user=ci-deploy

[pve_host:vars]
ansible_ssh_private_key_file=~/.ssh/homelab_ci_deploy
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new

# Group `vault_host`, machine `vault` — the same split as pve_host/pve, and for
# the same reason: a group and a host sharing one name makes `--limit vault`
# ambiguous, and Ansible only warns about it. The MACHINE name is what matters
# downstream — the tailscale role defaults tailscale_hostname to it, so this is
# what makes the guest vault.ts.conway-hash.com.
[vault_host]
# Reached by ProxyJump through the hypervisor, not by tailnet name, and
# deliberately so. The tailnet name would work once the tailscale role has run,
# but it would ALSO be the only way in — so a guest whose tailnet join broke
# would be unreachable by the very playbook that could fix it. The hypervisor
# is on the tailnet and on the LAN, which makes it a door that stays open.
#
# The address is static and set in group_vars/pve_host/vars.yml, not leased,
# because Ansible has to know it before the machine has ever booted.
vault ansible_host=1.1.1.21 ansible_user=ci-deploy

[vault_host:vars]
ansible_ssh_private_key_file=~/.ssh/homelab_ci_deploy
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -W %h:%p -q -i ~/.ssh/homelab_ci_deploy -o StrictHostKeyChecking=accept-new ci-deploy@pve.ts.conway-hash.com"

# Group `links_host`, machine `links` — same split as vault_host/vault.
[links_host]
# Reached by ProxyJump through the hypervisor, not by tailnet name, and
# deliberately so: the tailnet name would work once the tailscale role has run,
# but it would ALSO be the only way in, so a guest whose tailnet join broke
# would be unreachable by the very playbook that could fix it.
links ansible_host=1.1.1.22 ansible_user=ci-deploy

[links_host:vars]
ansible_ssh_private_key_file=~/.ssh/homelab_ci_deploy
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -W %h:%p -q -i ~/.ssh/homelab_ci_deploy -o StrictHostKeyChecking=accept-new ci-deploy@pve.ts.conway-hash.com"

# The Obsidian sync server (VM 100) is NOT managed here and is NOT on the
# tailnet — nothing outside the LAN can reach it. It predates this repo and
# stays out of scope.
#
# [obsidian]
# obsidian ansible_host=obsidian.ts.conway-hash.com ansible_user=ci-deploy
