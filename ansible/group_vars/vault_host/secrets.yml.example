# Copy to secrets.yml for a local run (git-ignored — never commit real values).
# In CI this file is generated at runtime from GitHub Secrets and never touches
# the repo; see .github/workflows/deploy.yml.

# ONLY needed to put this guest on the tailnet for the FIRST time. Once joined,
# it converges without this — the tailscale role asserts on it conditionally.
#
# Must be NON-ephemeral and single-use: this is a permanent machine. An
# ephemeral key makes the node delete itself the moment it disconnects, which
# is what CI's throwaway runner wants and the opposite of what a vault needs.
#
#   sudo docker exec headscale headscale preauthkeys create --user 1
tailscale_authkey: "CHANGEME"

# Argon2 PHC hash of the admin password, NOT the password itself:
#
#   docker run --rm -it vaultwarden/server /vaultwarden hash
#
# Gates /admin, which can read and rewrite every setting on the instance.
svc_vaultwarden_admin_token: "CHANGEME"

# Cloudflare API token for the ACME DNS-01 challenge. Mint it from the
# "Edit zone DNS" template restricted to the one zone — that is Zone:Read +
# DNS:Edit, and the plugin needs both: it walks up from _acme-challenge.<host>
# to find the owning zone, which DNS:Edit alone cannot do.
svc_vaultwarden_cloudflare_api_token: "CHANGEME"
