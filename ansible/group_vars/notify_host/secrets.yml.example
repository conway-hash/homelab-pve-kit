# Copy to secrets.yml for a local run (git-ignored — never commit real
# values). In CI this file is generated at runtime from the `notify` GitHub
# Environment's SERVICE_SECRETS bundle and never touches the repo; see
# .github/workflows/deploy.yml and docs/notify.md.

# ONLY needed to put this guest on the tailnet for the FIRST time. A machine
# that has already joined converges without this, so routine runs need no
# secret at all — the tailscale role asserts on it conditionally.
#
# Must be NON-ephemeral: this is a permanent machine, and an ephemeral key
# makes the node delete itself the moment it disconnects. Mint it with:
#
#   sudo docker exec headscale headscale preauthkeys create --user 1
tailscale_authkey: "CHANGEME"

# The account every SERVICE publishes as. Write-only.
svc_ntfy_publisher_password: "CHANGEME"

# The account the phone subscribes as. Read-only.
svc_ntfy_phone_password: "CHANGEME"

# Its OWN Cloudflare token, not a copy of the vault's — see defaults/main.yml.
svc_ntfy_cloudflare_api_token: "CHANGEME"
