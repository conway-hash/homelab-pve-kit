# Copy to secrets.yml for a local run (git-ignored — never commit real values).
# In CI this file is generated at runtime from GitHub Secrets.

# ONLY needed for the FIRST tailnet join. Must be NON-ephemeral: this is a
# permanent machine, and an ephemeral key makes it delete itself the moment it
# disconnects.
#
#   sudo docker exec headscale headscale preauthkeys create --user 1
tailscale_authkey: "CHANGEME"

# EXACTLY 32 characters. Encrypts sessions and anything Firefly stores
# encrypted — rotating it logs everyone out and orphans existing values.
#
#   openssl rand -base64 24
svc_firefly_app_key: "CHANGEME"

# EXACTLY 32 characters. Firefly refuses to run its scheduled jobs at any
# other length, and refuses quietly.
#
#   openssl rand -hex 16
svc_firefly_cron_token: "CHANGEME"

#   openssl rand -base64 32 | tr -d '/+='
svc_firefly_postgres_password: "CHANGEME"

# Its OWN Cloudflare token — same zone and permissions as the other services',
# but revoking one must not take the rest down.
svc_firefly_cloudflare_api_token: "CHANGEME"
