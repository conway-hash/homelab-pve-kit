# Copy to secrets.yml for a local run (git-ignored — never commit real values).
# In CI this file is generated at runtime from GitHub Secrets and never touches
# the repo; see .github/workflows/deploy.yml.

# ONLY needed to put this guest on the tailnet for the FIRST time. Once joined,
# it converges without this — the tailscale role asserts on it conditionally.
#
# Must be NON-ephemeral: this is a permanent machine, and an ephemeral key
# makes the node delete itself the moment it disconnects.
#
#   sudo docker exec headscale headscale preauthkeys create --user 1
tailscale_authkey: "CHANGEME"

# Signs and encrypts session cookies. Anyone holding it can mint a valid
# session for any account without knowing a password.
#
#   openssl rand -base64 32
svc_linkwarden_nextauth_secret: "CHANGEME"

# Postgres password. Keep it URL-safe — it is interpolated into DATABASE_URL.
#
#   openssl rand -base64 32 | tr -d '/+='
svc_linkwarden_postgres_password: "CHANGEME"

# Meilisearch master key. Without one, anything reaching the container can read
# and rewrite the full-text index of every page archived.
#
#   openssl rand -base64 32
svc_linkwarden_meili_master_key: "CHANGEME"

# Cloudflare API token for the ACME DNS-01 challenge.
#
# ⚠️ Mint a SEPARATE token from the vault's — same zone, same permissions, but
# revoking one must not take the other down and the audit log should say which
# service wrote which record.
svc_linkwarden_cloudflare_api_token: "CHANGEME"
