# Copy to secrets.yml for a local run (git-ignored — never commit real
# values). In CI this file is generated at runtime from the `watch` GitHub
# Environment's SERVICE_SECRETS bundle and never touches the repo; see
# .github/workflows/deploy.yml and docs/watch.md.

# ONLY needed to put this guest on the tailnet for the FIRST time. Must be
# NON-ephemeral — this is a permanent machine, and an ephemeral key makes the
# node delete itself the moment it disconnects.
tailscale_authkey: "CHANGEME"

# Secret half of the Proxmox API token. ⚠️ NOT the privsep-0 `homelab` token
# pve_guests uses — mint a separate, narrower one. docs/watch.md has the exact
# `pveum` commands.
svc_watch_pve_token_secret: "CHANGEME"

# The SAME value as svc_ntfy_publisher_password on the ntfy guest. Neither
# guest can read the other's secrets, so this one value is declared in both
# bundles — the one place this repo tolerates that, and docs/ntfy.md says so.
svc_watch_ntfy_password: "CHANGEME"

# Gates the control endpoints (reboot the node, start/stop a guest). Leave it
# EMPTY to disable controls entirely — watchd answers 503 and the dashboard
# hides the buttons.
#
#   openssl rand -hex 32
svc_watch_control_token: ""

# Its OWN Cloudflare token, not a copy of another service's.
svc_watch_cloudflare_api_token: "CHANGEME"
