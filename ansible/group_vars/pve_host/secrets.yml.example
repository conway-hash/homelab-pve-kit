# Copy to secrets.yml for a local run (git-ignored — never commit real
# values). In CI this file is generated at runtime from GitHub Secrets and
# never touches the repo; see .github/workflows/deploy.yml.

# ONLY needed to put a host on the tailnet for the FIRST time. A machine
# that has already joined converges without this, so routine runs need no
# secret at all — the tailscale role asserts on it conditionally.
#
# Must be NON-ephemeral and single-use: this is a permanent machine. An
# ephemeral key makes the node delete itself the moment it disconnects,
# which is what CI's throwaway runner wants and what a hypervisor very
# much does not. Mint it with:
#
#   sudo docker exec headscale headscale preauthkeys create --user 1
#
# See SETUP.md.
tailscale_authkey: "CHANGEME"

# ── Guests ───────────────────────────────────────────────────────────

# Secret half of the Proxmox API token that creates and removes guests. The
# user and token ID are not secret and live in vars.yml; only this is.
#
# Shown exactly once, when the token is created:
#
#   pveum user token add automation@pve homelab --privsep 0
pve_guests_api_token_secret: "CHANGEME"

# PUBLIC half of the ci-deploy key — not a secret, but it has no safe default
# and a guest built without it is unreachable:
#
#   ssh-keygen -y -f ~/.ssh/homelab_ci_deploy
pve_guests_ssh_public_key: "ssh-ed25519 AAAA... homelab-pve ci-deploy"
