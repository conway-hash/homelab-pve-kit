# Managed by Ansible (svc_linkwarden) — edits will be overwritten.
#
# The containers' `restart: unless-stopped` would bring them up after a reboot
# without this unit at all; what the unit adds is a single name that Ansible's
# handlers and the self-heal timer can restart the whole stack by, and a
# `systemctl status` answer to "is this meant to be running".

[Unit]
Description=Linkwarden stack (app + postgres + meilisearch + Caddy)
Requires=docker.service
# tailscaled is in the ordering because the compose file publishes on this
# guest's tailnet address. If that interface has no address yet, Docker cannot
# bind and the containers fail to start. tailscaled restores its address from
# local state without needing to reach the coordination server, so this costs
# nothing on a cold boot with the internet down.
After=docker.service network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ linkwarden_dir }}

# `up -d --build` rather than plain `up -d`: Caddy is built from a Dockerfile
# here, and without --build a version bump would start the previously built
# image and report success.
ExecStart=/usr/bin/docker compose up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose down

# The build can pull a Go toolchain on a cold cache, and the app runs database
# migrations on its first boot.
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
