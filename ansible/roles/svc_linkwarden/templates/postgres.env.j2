# Managed by Ansible (svc_linkwarden) — edits will be overwritten.
# Mode 0600: this file holds the database password.

# User and database are named explicitly rather than left as the `postgres`
# default, so the healthcheck in compose.yml and DATABASE_URL in
# linkwarden.env can both name the same thing and be checked against each
# other by reading, not by remembering what the image defaults to.
POSTGRES_USER=linkwarden
POSTGRES_DB=linkwarden
POSTGRES_PASSWORD={{ svc_linkwarden_postgres_password }}
