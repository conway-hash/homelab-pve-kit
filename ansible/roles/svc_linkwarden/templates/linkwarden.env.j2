# Managed by Ansible (svc_linkwarden) — edits will be overwritten.
# Mode 0600: this file holds the session secret, the database URL and the
# Meilisearch master key.
#
# An env_file rather than compose.yml's `environment:` on purpose — Compose
# interpolates '$' in that block, and a base64 secret can contain one.

# The public origin, which must match what a browser actually types. NextAuth
# builds its callback URLs from this, so a mismatch does not fail loudly — it
# redirects you to the wrong host after login and looks like a broken session.
NEXTAUTH_URL=https://{{ linkwarden_domain }}/api/v1/auth
NEXTAUTH_SECRET={{ svc_linkwarden_nextauth_secret }}

# The password is percent-encoded because this is a URL, not a config value:
# a `@` or `/` in the password would otherwise be read as the host or path
# separator and produce a connection error that names neither.
DATABASE_URL=postgresql://linkwarden:{{ svc_linkwarden_postgres_password | urlencode }}@postgres:5432/linkwarden

MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY={{ svc_linkwarden_meili_master_key }}

# The single most important line in this file. Linkwarden ships with
# registration OPEN. On an instance anything on the tailnet can reach, leaving
# it open means any device that joins can create itself an account — the same
# mistake the vault's SIGNUPS_ALLOWED exists to prevent, spelled differently.
#
# Deliberately not a var: it is not a knob anyone should reach for on a
# personal bookmark archive. You make your own account by turning this off
# AFTER first registration — see docs/links.md.
NEXT_PUBLIC_DISABLE_REGISTRATION={{ linkwarden_disable_registration | lower }}

# Which user id is treated as the administrator. 1 is the first account
# created, which is yours if you followed docs/links.md.
NEXT_PUBLIC_ADMIN=1
