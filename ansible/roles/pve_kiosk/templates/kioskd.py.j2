#!/usr/bin/env python3
# Managed by Ansible (pve_kiosk) — edits will be overwritten
#
# One process: samples this box, keeps the history the graphs draw, and
# serves both plus the page itself on 127.0.0.1.
#
# This replaced a bash collector on a 10s systemd timer writing one
# data.json, with python3 -m http.server in front of it. Three reasons it
# had to go:
#
#   1. A timer has exactly one interval, so everything ran at the speed of
#      the slowest source. /proc/stat is free and `pvesh` costs ~150ms, so
#      "cheap enough for 1s" got dragged down to 10s and the graphs were
#      staircases.
#   2. History lived in the browser, so every reload started the lines over.
#   3. Twelve cores, per-guest agent calls and per-peer TLS probes in
#      bash+jq is where that script stopped being the simple option.
#
# Nothing but the standard library — python3 is already on a Proxmox host
# because Proxmox itself uses it, and adding a web framework to hand JSON
# to a browser on the same machine would be the heavier choice.
import fnmatch
import json
import os
import re
import socket
import ssl
import subprocess
import threading
import time
from collections import deque
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

