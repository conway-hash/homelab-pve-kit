def sh(*args, timeout=10):
    """Run a command, return stdout, never raise.

    Every source has to fail alone: a wedged tailscaled must not blank the
    guest list, and a guest without an agent must not stop the GPU graph.
    """
    try:
        out = subprocess.run(
            args, capture_output=True, timeout=timeout, check=False
        )
        return out.stdout.decode("utf-8", "replace") if out.returncode == 0 else ""
    except Exception:
        return ""


def pvesh(path, *args, timeout=10):
    """`pvesh get <path> [--flag value]`.

    Options go through as flags, never as a query string on the path —
    `pvesh get /nodes/pve/tasks?limit=60` does not fail loudly, it answers
    "No 'get' handler defined" and this returns an empty log with no
    indication anything went wrong.
    """
    raw = sh("pvesh", "get", path, *args, "--output-format", "json",
             timeout=timeout)
    try:
        return json.loads(raw) if raw else None
    except ValueError:
        return None


def read(path, default=""):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def readint(path, default=0):
    try:
        return int(read(path, ""))
    except ValueError:
        return default


class Series:
    """A fixed-length ring of samples, addressed by a global sequence number.

    The page asks for everything after the last sequence it saw, so a 1Hz
    poll ships one number per series instead of the whole window. `base` is
    the sequence of the oldest sample still held; asking for anything older
    than that gets the full window back instead.
    """

    def __init__(self):
        self.v = deque(maxlen=KEEP)
        self.base = 0

    def push(self, value):
        if len(self.v) == KEEP:
            self.base += 1
        self.v.append(value)

    def since(self, seq):
        if seq is None or seq < self.base:
            return list(self.v), self.base
        off = seq - self.base
        return list(self.v)[off:], seq


class State:
    def __init__(self):
        self.lock = threading.Lock()
        self.seq = 0
        self.series = {}
        self.now = {}
        self.guests = []
        self.guest_hist = {}
        self.tailnet = {}
        self.slow = {}
        self.actions = deque(maxlen=40)

    def s(self, key):
        if key not in self.series:
            self.series[key] = Series()
        return self.series[key]


ST = State()


# ── local sampling ───────────────────────────────────────────────────
# Everything in this section reads /proc or /sys and returns in
# microseconds, which is what makes a 1s tick reasonable.


def cpu_times():
    """Per-core jiffy counters. Index 0 is the aggregate 'cpu' line."""
    out = []
    for line in read("/proc/stat").splitlines():
        if not line.startswith("cpu"):
            break
        f = line.split()
        vals = [int(x) for x in f[1:]]
        idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
        out.append((sum(vals), idle))
    return out


def meminfo():
    m = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        m[k] = int(v.split()[0]) * 1024
    total = m.get("MemTotal", 0)
    # MemAvailable, not MemFree: the kernel counts reclaimable page cache
    # as free-for-practical-purposes, and on a hypervisor that cache is
    # most of "used" on any box with uptime. Reporting MemFree here is what
    # makes a healthy machine look like it is out of RAM.
    avail = m.get("MemAvailable", m.get("MemFree", 0))
    return {
        "total": total,
        "used": total - avail,
        "available": avail,
        "cached": m.get("Cached", 0) + m.get("SReclaimable", 0),
        "buffers": m.get("Buffers", 0),
        "swap_total": m.get("SwapTotal", 0),
        "swap_used": m.get("SwapTotal", 0) - m.get("SwapFree", 0),
    }


def hwmon_by_name():
    found = {}
    base = "/sys/class/hwmon"
    try:
        for entry in os.listdir(base):
            found.setdefault(read(f"{base}/{entry}/name"), f"{base}/{entry}")
    except OSError:
        pass
    return found


def cpu_temps(hw):
    """Whatever this CPU actually exposes, labelled the way the driver does.

    On the Ryzen 3600X in this box k10temp offers exactly two: Tctl (the
    control loop's value, which is what the fan curve follows) and Tccd1
    (the die's real sensor). There is no per-core temperature to read on
    this part — asking for twelve numbers cannot produce them, so the page
    shows the two that exist rather than inventing ten.
    """
    path = hw.get("k10temp") or hw.get("coretemp")
    if not path:
        return []
    out = []
    for idx in range(1, 12):
        raw = f"{path}/temp{idx}_input"
        if not os.path.exists(raw):
            continue
        out.append(
            {
                "label": read(f"{path}/temp{idx}_label", f"temp{idx}"),
                "c": round(readint(raw) / 1000, 1),
            }
        )
    return out


def gpu_sample(hw):
    dev = None
    for card in sorted(os.listdir("/sys/class/drm")):
        cand = f"/sys/class/drm/{card}/device"
        if re.fullmatch(r"card\d+", card) and os.path.exists(
            f"{cand}/gpu_busy_percent"
        ):
            dev = cand
            break
    if not dev:
        return None
    mon = hw.get("amdgpu", "")
    total = readint(f"{dev}/mem_info_vram_total")
    return {
        "name": GPU_NAME_OVERRIDE or GPU_INFO["name"],
        "driver": GPU_INFO["driver"],
        "pci": GPU_INFO["pci"],
        "busy": readint(f"{dev}/gpu_busy_percent"),
        "mem_busy": readint(f"{dev}/mem_busy_percent"),
        "vram_used": readint(f"{dev}/mem_info_vram_used"),
        "vram_total": total,
        "temp": round(readint(f"{mon}/temp1_input") / 1000, 1) if mon else 0,
        "fan_rpm": readint(f"{mon}/fan1_input") if mon else 0,
        "watts": round(readint(f"{mon}/power1_input") / 1e6, 1) if mon else 0,
        "sclk": round(readint(f"{mon}/freq1_input") / 1e6),
        "mclk": round(readint(f"{mon}/freq2_input") / 1e6),
    }


def gpu_identify():
    """The best name available, and honest about where it came from.

    lspci reads the shared PCI ID database, where 1002:67df is one entry
    covering the entire RX 470/480/570/580/590 family — the ID genuinely
    does not distinguish them. The subsystem ID gets as far as the board
    partner's model line. kiosk_gpu_name overrides both when you know
    exactly which card is in the slot.
    """
    info = {"name": "GPU", "driver": "", "pci": ""}
    for line in sh("lspci", "-nn", "-D").splitlines():
        if re.search(r"(VGA compatible controller|3D controller)", line):
            info["pci"] = line.split()[0]
            desc = line.split(": ", 1)[-1]
            sub = sh("lspci", "-s", info["pci"], "-v")
            match = re.search(r"Subsystem: (.+)", sub)
            info["name"] = (match.group(1) if match else desc).split(" [")[0].strip()
            drv = re.search(r"Kernel driver in use: (\S+)", sub)
            info["driver"] = drv.group(1) if drv else ""
            break
    return info


GPU_INFO = gpu_identify()


def net_counters():
    """Byte counters per interface, only for the ones that mean something.

    vmbr0 and tailscale0 are not the same number counted twice, which is
    the obvious suspicion given they share one physical NIC. vmbr0 is the
    Linux bridge carrying every guest's traffic on the LAN in cleartext;
    tailscale0 is the WireGuard tunnel, and a byte on it is counted again
    on vmbr0 on its way out, encrypted. So tailscale0 is a strict subset of
    vmbr0, measured before encapsulation.
    """
    out = {}
    for line in read("/proc/net/dev").splitlines()[2:]:
        name, _, rest = line.partition(":")
        name = name.strip()
        # tap interfaces are deliberately absent: a tap is one guest's
        # virtual NIC, and that guest's own card already carries its traffic.
        # Collecting a series per guest here only grew the payload and the
        # network panel with numbers that belong somewhere else.
        if not re.fullmatch(r"(vmbr\d+|tailscale\d+)", name):
            continue
        f = rest.split()
        out[name] = (int(f[0]), int(f[8]))
    return out


PREV_CPU = None
PREV_NET = None
PREV_NET_T = None


def fast_tick():
    global PREV_CPU, PREV_NET, PREV_NET_T
    hw = hwmon_by_name()
    now = time.time()

    cpu = cpu_times()
    pct = []
    if PREV_CPU and len(PREV_CPU) == len(cpu):
        for (t0, i0), (t1, i1) in zip(PREV_CPU, cpu):
            dt, di = t1 - t0, i1 - i0
            pct.append(round(max(0.0, min(100.0, (dt - di) / dt * 100)), 1) if dt else 0.0)
    else:
        pct = [0.0] * len(cpu)
    PREV_CPU = cpu

    mem = meminfo()
    gpu = gpu_sample(hw)
    temps = cpu_temps(hw)

    counters = net_counters()
    rates = {}
    if PREV_NET and PREV_NET_T:
        dt = max(0.001, now - PREV_NET_T)
        for name, (rx, tx) in counters.items():
            if name not in PREV_NET:
                continue
            prx, ptx = PREV_NET[name]
            # A counter that went backwards means the interface was
            # recreated, not that traffic was negative.
            rates[name] = {
                "rx": max(0, int((rx - prx) / dt)),
                "tx": max(0, int((tx - ptx) / dt)),
                "total_rx": rx,
                "total_tx": tx,
            }
    PREV_NET, PREV_NET_T = counters, now

    load = [float(x) for x in read("/proc/loadavg", "0 0 0").split()[:3]]
    uptime = float(read("/proc/uptime", "0").split()[0])

    with ST.lock:
        ST.seq += 1
        ST.s("cpu").push(pct[0] if pct else 0.0)
        for i, value in enumerate(pct[1:]):
            ST.s(f"core{i}").push(value)
        ST.s("mem").push(round(mem["used"] / mem["total"] * 100, 1) if mem["total"] else 0)
        for temp in temps:
            ST.s("t_" + temp["label"]).push(temp["c"])
        if gpu:
            ST.s("gpu").push(float(gpu["busy"]))
            ST.s("gpu_mem").push(
                round(gpu["vram_used"] / gpu["vram_total"] * 100, 1)
                if gpu["vram_total"]
                else 0
            )
            ST.s("gpu_temp").push(gpu["temp"])
        for name, r in rates.items():
            ST.s(f"rx_{name}").push(r["rx"])
            ST.s(f"tx_{name}").push(r["tx"])
        ST.now = {
            "t": now,
            "cores": len(pct) - 1,
            "cpu_model": CPU_MODEL,
            "board": BOARD,
            "cpu": pct[0] if pct else 0.0,
            "per_core": pct[1:],
            "temps": temps,
            "mem": mem,
            "mem_hw": MEMORY_HW,
            "gpu": gpu,
            "net": rates,
            "load": load,
            "uptime": uptime,
        }


def memory_modules():
    """The sticks actually in the slots, from SMBIOS.

    Read once: swapping RAM is not something that happens while the daemon
    is running, and dmidecode forks and parses the whole table.
    """
    mods, cur = [], {}
    for line in sh("dmidecode", "-t", "memory", timeout=10).splitlines():
        line = line.strip()
        if line.startswith("Memory Device"):
            if cur:
                mods.append(cur)
            cur = {}
        elif ":" in line and cur is not None:
            k, _, v = line.partition(":")
            cur[k.strip()] = v.strip()
    if cur:
        mods.append(cur)

    fitted = [m for m in mods if "No Module" not in m.get("Size", "No Module")]
    if not fitted:
        return {"label": "", "detail": ""}
    first = fitted[0]
    size = first.get("Size", "")
    kind = first.get("Type", "")
    # "Speed" is what the stick is rated for at JEDEC; "Configured Memory
    # Speed" is what it is actually being clocked at. They differ whenever
    # XMP/DOCP is off, and the configured one is the true number.
    speed = first.get("Configured Memory Speed", first.get("Speed", ""))
    speed = speed.replace(" MT/s", "")
    part = first.get("Part Number", "").strip()
    label = f"{len(fitted)} × {size} {kind}".strip()
    if speed and speed.isdigit():
        label += f"-{speed}"
    return {"label": label, "detail": part, "slots": len(mods), "fitted": len(fitted)}


MEMORY_HW = memory_modules()


CPU_MODEL = next(
    (
        line.split(":", 1)[1].strip()
        for line in read("/proc/cpuinfo").splitlines()
        if line.startswith("model name")
    ),
    "CPU",
)
BOARD = " ".join(
    x
    for x in (
        read("/sys/class/dmi/id/board_vendor").split(" ")[0],
        read("/sys/class/dmi/id/board_name"),
    )
    if x
)


# ── guests ───────────────────────────────────────────────────────────


def guest_memory(vmid, fallback):
    """What the guest is actually using, not what QEMU has mapped.

    This is the bug the old dashboard had. `pvesh get /nodes/X/qemu` returns
    a `mem` field that is the QEMU *process* RSS on the host — for vault
    that reads 2.05 GiB against a 2 GiB assignment, i.e. over 100%, because
    it counts the emulator's own overhead alongside the guest's RAM.
    /status/current additionally carries `ballooninfo`, which the virtio
    balloon driver inside the guest fills in: total_mem minus free_mem is
    the number the guest itself would report, and the number Proxmox's own
    UI draws. Where there is no agent and no balloon, fall back and say so,
    rather than quietly showing the wrong one.
    """
    cur = pvesh(f"/nodes/{NODE}/qemu/{vmid}/status/current", timeout=8)
    if not cur:
        return {"used": fallback, "total": 0, "source": "host-rss"}
    b = cur.get("ballooninfo") or {}
    if b.get("total_mem") and b.get("free_mem") is not None:
        return {
            "used": b["total_mem"] - b["free_mem"],
            "total": b["total_mem"],
            "source": "balloon",
            "host_rss": cur.get("memhost", fallback),
        }
    return {
        "used": cur.get("mem", fallback),
        "total": cur.get("maxmem", 0),
        "source": "host-rss",
        "host_rss": cur.get("memhost", fallback),
    }


def agent_exec(vmid, *argv, timeout=12):
    """Run something inside a guest through the QEMU guest agent.

    No SSH, no key, no listening port in the guest — the agent is already
    enabled on every guest this repo builds, and the channel is a virtio
    serial device, so this works on a guest that has fallen off the network
    entirely. It does run as root in the guest, which is why the only
    things sent through it here are read-only listings.
    """
    raw = sh("qm", "guest", "exec", str(vmid), "--timeout", "8", "--", *argv,
             timeout=timeout)
    try:
        res = json.loads(raw) if raw else {}
    except ValueError:
        return None
    if res.get("exitcode") != 0:
        return None
    return res.get("out-data", "")


def guest_containers(vmid):
    """Every container, with whether its own healthcheck is passing.

    One `docker inspect` rather than `docker ps`, because the human-readable
    status string is the only place `ps` puts health, and reading "(healthy)"
    out of prose cannot distinguish "declares a check and passes it" from
    "declares no check at all". That distinction is the whole point: a
    container with no healthcheck is not unhealthy, and must not be drawn as
    though it were.
    """
    out = agent_exec(
        vmid,
        "/bin/sh",
        "-c",
        "docker ps -aq | xargs -r docker inspect --format "
        "'{% raw %}{{.Name}}\t{{.State.Status}}\t{{.Config.Image}}\t"
        "{{if .Config.Healthcheck}}{{if .State.Health}}{{.State.Health.Status}}"
        "{{else}}unknown{{end}}{{else}}none{{end}}{% endraw %}' 2>/dev/null",
    )
    if not out:
        return []
    rows = []
    for line in out.strip().splitlines():
        parts = line.split("\t")
        if len(parts) < 4:
            continue
        name, state, image, health = parts[0].lstrip("/"), parts[1], parts[2], parts[3]
        rows.append(
            {
                "name": name,
                "state": state,
                "image": image.split("@")[0],
                # none    — no healthcheck defined, so running is all we know
                # healthy — defined and passing
                # starting/unhealthy/unknown — defined and not passing yet
                "health": health,
                "ok": state == "running" and health in ("healthy", "none"),
                "warn": state == "running" and health not in ("healthy", "none"),
            }
        )
    return sorted(rows, key=lambda r: r["name"])


def guest_filesystems(vmid):
    raw = sh("qm", "agent", str(vmid), "get-fsinfo", timeout=12)
    if not raw:
        return []
    try:
        data = json.loads(raw)
    except ValueError:
        return []
    out = []
    for fs in data:
        total = fs.get("total-bytes") or 0
        if not total or fs.get("type") in ("tmpfs", "devtmpfs", "overlay"):
            continue
        out.append(
            {
                "mount": fs.get("mountpoint", "?"),
                "type": fs.get("type", ""),
                "total": total,
                "used": fs.get("used-bytes", 0),
            }
        )
    return sorted(out, key=lambda f: f["mount"])


def classify(g):
    if g.get("template"):
        return "template"
    return "automated" if g.get("vmid") in MANAGED_VMIDS else "manual"


AGENT_CACHE = {}
AGENT_LAST = 0.0


def guest_tick():
    global AGENT_LAST
    qemu = pvesh(f"/nodes/{NODE}/qemu", timeout=15) or []
    lxc = pvesh(f"/nodes/{NODE}/lxc", timeout=15) or []
    do_agent = time.time() - AGENT_LAST >= AGENT

    rows = []
    for g in qemu + [dict(x, _lxc=True) for x in lxc]:
        vmid = g.get("vmid")
        running = g.get("status") == "running"
        row = {
            "vmid": vmid,
            "name": g.get("name") or str(vmid),
            "kind": "ct" if g.get("_lxc") else "vm",
            "group": classify(g),
            "status": g.get("status", "unknown"),
            "running": running,
            "uptime": g.get("uptime", 0),
            "tags": [t for t in (g.get("tags") or "").split(";") if t],
            # Allocation, which is a fact about the config and true whether
            # or not the guest is on. The graphs show consumption against
            # these ceilings.
            "alloc": {
                "cores": g.get("cpus", 0),
                "memory": g.get("maxmem", 0),
                "disk": g.get("maxdisk", 0),
            },
            "cpu": round((g.get("cpu") or 0) * 100, 1),
            "net": {"rx": g.get("netin", 0), "tx": g.get("netout", 0)},
        }
        if running and not g.get("_lxc"):
            row["memory"] = guest_memory(vmid, g.get("mem", 0))
            if do_agent:
                AGENT_CACHE[vmid] = {
                    "containers": guest_containers(vmid),
                    "fs": guest_filesystems(vmid),
                }
            row.update(AGENT_CACHE.get(vmid, {"containers": [], "fs": []}))
        elif running:
            row["memory"] = {
                "used": g.get("mem", 0),
                "total": g.get("maxmem", 0),
                "source": "lxc",
            }
            row["containers"] = []
            row["fs"] = []
        else:
            row["memory"] = {"used": 0, "total": g.get("maxmem", 0), "source": "off"}
            row["containers"] = []
            row["fs"] = []
        rows.append(row)

    if do_agent:
        AGENT_LAST = time.time()

    rows.sort(key=lambda r: (r["group"] != "automated", r["vmid"]))
    with ST.lock:
        for row in rows:
            hist = ST.guest_hist.setdefault(
                row["vmid"], {"cpu": deque(maxlen=120), "mem": deque(maxlen=120)}
            )
            hist["cpu"].append(row["cpu"])
            mem = row["memory"]
            hist["mem"].append(
                round(mem["used"] / mem["total"] * 100, 1) if mem.get("total") else 0
            )
            row["hist"] = {"cpu": list(hist["cpu"]), "mem": list(hist["mem"])}
        ST.guests = rows


# ── tailnet, and the wider world ─────────────────────────────────────


def https_probe(host, timeout=3):
    """Connect to 443 and read the certificate. No request is ever sent.

    Enough to answer "does this name have a working HTTPS front door", and
    cheap enough to do for every peer once a minute. A self-signed or
    otherwise unverifiable certificate still counts as *reachable* — it is
    reported separately rather than as a failure, because on a tailnet a
    self-signed certificate is a normal thing to find.
    """
    ctx = ssl.create_default_context()
    try:
        with socket.create_connection((host, 443), timeout) as raw:
            with ctx.wrap_socket(raw, server_hostname=host) as tls:
                cert = tls.getpeercert()
                exp = datetime.strptime(
                    cert["notAfter"], "%b %d %H:%M:%S %Y %Z"
                ).replace(tzinfo=timezone.utc)
                days = (exp - datetime.now(timezone.utc)).days
                issuer = dict(x[0] for x in cert.get("issuer", ()))
                return {
                    "https": True,
                    "valid": True,
                    "days": days,
                    "issuer": issuer.get("organizationName", ""),
                }
    except ssl.SSLError:
        return {"https": True, "valid": False, "days": None, "issuer": ""}
    except Exception:
        return {"https": False, "valid": False, "days": None, "issuer": ""}


def tailnet_tick():
    raw = sh("tailscale", "status", "--json", timeout=8)
    try:
        ts = json.loads(raw) if raw else {}
    except ValueError:
        ts = {}
    if not ts.get("Self"):
        return {"ok": False, "nodes": [], "relays": []}

    guest_names = {g["name"].lower() for g in ST.guests}
    relays = set()

    def kind_of(name, os_name, me, is_guest):
        """What this node physically is, for picking an icon.

        Tailscale reports an OS and nothing else, which separates a phone
        from everything with a Linux kernel and stops there — a laptop, a
        Raspberry Pi and a hypervisor are all "linux". So the two facts this
        box genuinely knows come first (it is itself; it hosts this guest),
        and anything finer has to be told to it via kiosk_node_kinds.
        """
        if name in NODE_KINDS:
            return NODE_KINDS[name]
        if me:
            return "server"
        if is_guest:
            return "vm"
        if (os_name or "").lower() in ("android", "ios", "iphone", "ipados"):
            return "phone"
        return "desktop"

    def node(p, me=False):
        name = p.get("HostName") or "?"
        dns = (p.get("DNSName") or "").rstrip(".")
        online = True if me else bool(p.get("Online"))
        direct = bool(p.get("CurAddr"))
        relay = p.get("Relay") or ""
        if online and not direct and relay and not me:
            relays.add(relay)
        return {
            "id": p.get("ID") or name,
            # The name Headscale knows it by, which is what the admin panel
            # shows — not a prettified version of it.
            "name": name,
            "dns": dns,
            "ip": (p.get("TailscaleIPs") or [""])[0],
            "os": p.get("OS", ""),
            "self": me,
            "online": online,
            "link": "self" if me else ("direct" if direct else ("relay" if online else "offline")),
            "relay": relay,
            "addr": p.get("CurAddr", ""),
            # A guest of this hypervisor is drawn inside the hypervisor's
            # group. That is the only "is under" relationship this box can
            # actually observe — Headscale has no notion of one node
            # hosting another, so matching the tailnet name against the
            # guest list is what tells us vault lives on pve.
            "parent": NODE if (not me and name.lower() in guest_names) else None,
            "kind": kind_of(name, p.get("OS", ""), me, name.lower() in guest_names),
            "https": None,
        }

    nodes = [node(ts["Self"], me=True)]
    nodes += [
        node(p)
        for p in (ts.get("Peer") or {}).values()
        # CI joins the tailnet as an ephemeral node for the length of a
        # deploy and is reaped afterwards. Drawing it means a machine with a
        # run-ID for a name appears on the screen for five minutes and is
        # gone before anyone asks what it was.
        if not any(
            fnmatch.fnmatch(p.get("HostName") or "", pat) for pat in TAILNET_HIDE
        )
    ]

    wanted = [n for n in nodes if n["online"] and (not HTTPS_HOSTS or n["name"] in HTTPS_HOSTS)]
    threads = []
    for n in wanted:
        if not n["dns"]:
            continue

        def probe(target=n):
            target["https"] = https_probe(target["dns"])

        th = threading.Thread(target=probe, daemon=True)
        th.start()
        threads.append(th)
    for th in threads:
        th.join(timeout=6)

    return {
        "ok": ts.get("BackendState") == "Running",
        "state": ts.get("BackendState", "unknown"),
        "nodes": nodes,
        "relays": sorted(relays),
    }


def filesystems():
    out = []
    raw = sh(
        "df", "-B1", "-x", "tmpfs", "-x", "devtmpfs", "-x", "efivarfs", "-x", "overlay",
        "--output=source,target,fstype,size,used",
    )
    for line in raw.splitlines()[1:]:
        f = line.split()
        if len(f) < 5 or f[1] == "/etc/pve":
            # Proxmox's own config fuse mount: always a few KB of a fixed
            # 128 MB, and never says anything about disk pressure.
            continue
        out.append(
            {
                "device": f[0],
                "mount": f[1],
                "type": f[2],
                "total": int(f[3]),
                "used": int(f[4]),
            }
        )
    return sorted(out, key=lambda x: -x["total"])


def pending_updates():
    """Split by what it costs you to take them.

    Security patches land on their own overnight and need nothing from you.
    A kernel or a pve-manager bump is the class you asked to approve by
    hand, so they are counted separately and the page treats them
    differently.
    """
    raw = sh("apt-get", "-s", "-o", "Debug::NoLocking=1", "dist-upgrade", timeout=90)
    items = []
    for line in raw.splitlines():
        # The [current-version] bracket is absent when the package is not
        # installed yet — which is the shape of every new kernel, since
        # Proxmox installs alongside rather than over. Matching it as
        # required silently dropped exactly the updates worth approving.
        m = re.match(r"^Inst (\S+)(?: \[([^\]]*)\])? \(([^ ]+) ([^:]+)", line)
        if not m:
            continue
        name, cur, new, origin = m.groups()
        cur = cur or "(new)"
        items.append(
            {
                "name": name,
                "from": cur,
                "to": new,
                "origin": origin.strip(),
                "security": "security" in origin.lower(),
                "needs_reboot": bool(
                    re.match(r"^(linux-image|linux-headers|pve-kernel|proxmox-kernel)", name)
                ),
                "pve": name.startswith(("pve-", "proxmox-", "qemu-server", "libpve")),
            }
        )
    return sorted(items, key=lambda i: (not i["security"], i["name"]))


def pve_tasks(limit=60):
    rows = pvesh(f"/nodes/{NODE}/tasks", "--limit", str(limit), timeout=15) or []
    out = []
    for t in rows:
        out.append(
            {
                "t": t.get("starttime", 0),
                "end": t.get("endtime"),
                "type": t.get("type", ""),
                "id": t.get("id", ""),
                "user": t.get("user", ""),
                "status": t.get("status", "running"),
                "ok": t.get("status") in (None, "OK"),
                "source": "pve",
            }
        )
    return out


def journal_errors(limit=40):
    raw = sh(
        "journalctl", "-p", "warning", "-n", str(limit * 6), "-o", "json",
        "--no-pager", "--since", "-6h", timeout=20,
    )
    # A service that is unhappy is usually unhappy repeatedly, and forty
    # identical lines is a log pane that shows one event. Collapse to the
    # most recent of each distinct message and carry the count.
    seen = {}
    for line in raw.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        ident = e.get("SYSLOG_IDENTIFIER") or e.get("_COMM", "")
        msg = (e.get("MESSAGE") or "")[:300]
        # Addresses, pids and paths differ between otherwise identical
        # events, so they are normalised out before comparing.
        key = (ident, re.sub(r"\d{2,}", "#", msg))
        row = seen.get(key)
        stamp = int(e.get("__REALTIME_TIMESTAMP", 0)) / 1e6
        if row:
            row["count"] += 1
            row["t"] = max(row["t"], stamp)
            continue
        seen[key] = {
            "t": stamp,
            "type": ident,
            "id": "",
            "user": "",
            "status": "warn" if int(e.get("PRIORITY", 6)) >= 4 else "err",
            "ok": False,
            "msg": msg,
            "count": 1,
            "source": "journal",
        }
    return sorted(seen.values(), key=lambda r: -r["t"])[:limit]


def slow_tick():
    net_up = False
    try:
        socket.create_connection(("8.8.8.8", 53), 3).close()
        net_up = True
    except OSError:
        pass

    code = 0
    for path in ("/health", "/"):
        raw = sh(
            "curl", "-s", "-o", "/dev/null", "-w", "%{http_code}",
            "--max-time", "4", CONTROL_URL + path, timeout=8,
        )
        code = int(raw or 0)
        if code:
            break

    failed = [
        line.split()[0]
        for line in sh(
            "systemctl", "list-units", "--state=failed", "--no-legend", "--plain"
        ).splitlines()
        if line.strip()
    ]

    updates = pending_updates()
    logs = sorted(pve_tasks() + journal_errors(), key=lambda x: -x["t"])[:80]

    tn = tailnet_tick()

    with ST.lock:
        ST.tailnet = tn
        ST.slow = {
            "generated": time.time(),
            "node": NODE,
            "internet": net_up,
            "control": {
                "url": CONTROL_URL,
                "code": code,
                "online": 200 <= code < 500,
            },
            "fs": filesystems(),
            "failed": failed,
            "updates": updates,
            "reboot_required": os.path.exists("/var/run/reboot-required"),
            "reboot_pkgs": read("/var/run/reboot-required.pkgs").splitlines(),
            "pve_version": sh("pveversion").strip(),
            "logs": logs,
            "lofi": lofi_state(),
        }


# ── the lofi stream ──────────────────────────────────────────────────


def lofi_state():
    active = (
        subprocess.run(
            ["systemctl", "is-active", "--quiet", "kiosk-lofi.service"], check=False
        ).returncode
        == 0
    )
    return {
        "playing": active,
        "configured": bool(LOFI["url"]),
        "start": LOFI["start"],
        "stop": LOFI["stop"],
        "volume": LOFI["volume"],
        "ramp": LOFI["ramp"],
        "now": read(f"{DIR}/lofi-now", ""),
    }


# ── actions the screen can take ──────────────────────────────────────
#
# The security model used to be the bind address alone: one socket on
# 127.0.0.1 meant reaching these required being root on this box or standing
# at the monitor — the same bar as the physical power button, which does
# considerably more damage.
#
# Serving the page to the tailnet breaks that, so the check moved into the
# handler. A request's source address decides what it may run: rebooting the
# hypervisor still requires 127.0.0.1, while anything harmless is allowed
# from wherever the page itself is readable. Without this, putting the
# dashboard on the tailnet would have silently promoted "on the VPN" to
# "may reboot the server", which is not a trade anyone chose.
#
# Each one is still a hold-to-confirm on the page, because the realistic
# accident is a sleeve on the mouse, not an attacker.

LOCAL = ("127.0.0.1", "::1")

RUNNING = {}


def run_action(name, argv):
    def worker():
        started = time.time()
        proc = subprocess.run(argv, capture_output=True, check=False)
        with ST.lock:
            RUNNING.pop(name, None)
            ST.actions.appendleft(
                {
                    "t": started,
                    "name": name,
                    "ok": proc.returncode == 0,
                    "out": (proc.stdout + proc.stderr).decode("utf-8", "replace")[-4000:],
                }
            )

    with ST.lock:
        if name in RUNNING:
            return False
        RUNNING[name] = time.time()
    threading.Thread(target=worker, daemon=True).start()
    return True


# Each action says how far away it may be triggered from.
#
#   "local"   — 127.0.0.1 only, i.e. the keyboard physically wired to this
#               box. Anything that reboots the hypervisor or rewrites its
#               packages lives here: serving the page to the tailnet must
#               not quietly promote "on the VPN" to "may reboot the server".
#   "tailnet" — anywhere the page itself is reachable from. Starting music
#               is not in the same risk class as a reboot, and being able
#               to start it from the sofa is the point of it.
ACTIONS = {
    "upgrade": {
        "reach": "local",
        # `update` first, because the pending list this button acts on comes
        # from a simulated run against whatever is in the cache — which may
        # be a day old. --force-confold keeps config files you have edited
        # rather than prompting, since there is nobody at a terminal.
        #
        # A shell, uniquely here, because two commands have to run in order.
        # The argv is a fixed literal; nothing from a request reaches it.
        "argv": [
            "/bin/sh",
            "-c",
            "apt-get update && apt-get -y -o Dpkg::Options::=--force-confold dist-upgrade",
        ],
    },
    "reboot": {"reach": "local", "argv": ["systemctl", "reboot"]},
    "lofi-start": {"reach": "tailnet", "argv": ["systemctl", "start", "kiosk-lofi.service"]},
    "lofi-stop": {"reach": "tailnet", "argv": ["systemctl", "stop", "kiosk-lofi.service"]},
}


# ── serving ──────────────────────────────────────────────────────────


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        # A 1Hz poll would otherwise write 86400 lines a day into the
        # journal to say the dashboard is still up.
        pass

    def send_json(self, obj, code=200):
        body = json.dumps(obj, separators=(",", ":")).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path, _, query = self.path.partition("?")
        args = dict(
            kv.split("=", 1) for kv in query.split("&") if "=" in kv
        )
        if path == "/api/fast":
            raw = args.get("since")
            since = int(raw) if raw and raw.isdigit() else None
            with ST.lock:
                # Each series carries its own starting sequence. They do
                # not all begin on the same tick — network rates need a
                # previous sample to exist, so those series are one tick
                # younger than the CPU ones forever — and a single shared
                # offset would quietly shift one of them against the other.
                out = {}
                for key, series in ST.series.items():
                    vals, frm = series.since(since)
                    out[key] = {"from": frm, "v": vals}
                self.send_json(
                    {
                        "seq": ST.seq,
                        "step": FAST,
                        "keep": KEEP,
                        "series": out,
                        "now": ST.now,
                    }
                )
            return
        if path == "/api/slow":
            with ST.lock:
                self.send_json(
                    {
                        **ST.slow,
                        "guests": ST.guests,
                        "tailnet": ST.tailnet,
                        "actions": list(ST.actions)[:6],
                        "running": list(RUNNING),
                        # Told, not guessed: the page greys out what this
                        # viewer cannot do rather than offering a button
                        # that answers 403.
                        "local": self.client_address[0] in LOCAL,
                    }
                )
            return
        self.serve_file(path)

    def do_POST(self):
        if self.path != "/api/do":
            self.send_json({"error": "not found"}, 404)
            return
        # A cross-origin form post cannot set a custom header, so requiring
        # one means only the dashboard's own fetch() can reach this.
        if self.headers.get("X-Kiosk") != "1":
            self.send_json({"error": "missing X-Kiosk header"}, 403)
            return
        length = int(self.headers.get("Content-Length") or 0)
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            body = {}
        name = body.get("action")
        spec = ACTIONS.get(name)
        if not spec:
            self.send_json({"error": "unknown action"}, 400)
            return
        if spec["reach"] == "local" and self.client_address[0] not in LOCAL:
            self.send_json(
                {"error": f"{name} can only be run from the machine itself"}, 403
            )
            return
        self.send_json({"started": run_action(name, spec["argv"]), "action": name})

    def serve_file(self, path):
        name = "index.html" if path in ("/", "") else os.path.basename(path)
        full = os.path.join(DIR, name)
        if not os.path.isfile(full):
            self.send_json({"error": "not found"}, 404)
            return
        with open(full, "rb") as fh:
            body = fh.read()
        ctype = "text/html; charset=utf-8" if name.endswith(".html") else "text/plain"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)


def tailnet_address():
    """This host's own tailnet IPv4, or None if it is not on the tailnet.

    Read from tailscaled rather than assumed, so the address is never a
    second copy of a fact that lives somewhere else and can drift.
    """
    raw = sh("tailscale", "ip", "-4", timeout=6).strip()
    return raw.splitlines()[0].strip() if raw else None


def loop(fn, every, name):
    def run():
        while True:
            start = time.time()
            try:
                fn()
            except Exception as exc:  # a sampler must never take the daemon down
                print(f"[{name}] {exc.__class__.__name__}: {exc}", flush=True)
            time.sleep(max(0.05, every - (time.time() - start)))

    threading.Thread(target=run, daemon=True, name=name).start()


def main():
    fast_tick()
    loop(fast_tick, FAST, "fast")
    loop(guest_tick, GUEST, "guest")
    loop(slow_tick, SLOW, "slow")
    # The first slow pass shells out to apt and probes every peer, which
    # takes a few seconds; serving starts immediately and those panels fill
    # in when it lands, rather than holding the page back.
    binds = ["127.0.0.1"]
    if BIND_TAILNET:
        # The tailnet address specifically, NOT 0.0.0.0. This box's other
        # interface is the LAN bridge every guest and every device in the
        # house sits on; binding everything would publish the dashboard
        # there too, to anything that joined the wifi. Tailscale's address
        # is the one where being able to reach it already means something.
        addr = tailnet_address()
        if addr:
            binds.append(addr)
        else:
            print("no tailscale0 address yet — serving on localhost only",
                  flush=True)

    servers = []
    for host in binds:
        try:
            srv = ThreadingHTTPServer((host, PORT), Handler)
        except OSError as exc:
            print(f"cannot bind {host}:{PORT}: {exc}", flush=True)
            continue
        srv.daemon_threads = True
        servers.append(srv)
        print(f"kioskd listening on {host}:{PORT}", flush=True)

    if not servers:
        raise SystemExit("nothing to serve on")
    for srv in servers[1:]:
        threading.Thread(target=srv.serve_forever, daemon=True).start()
    servers[0].serve_forever()


if __name__ == "__main__":
    main()
