# Managed by Ansible (pve_kiosk) — edits will be overwritten
#
# python3's http.server, deliberately: it is already installed, serves a
# static directory, and pulling in a real web server to hand three files
# to a browser on the same machine would be the heavier choice.
#
# --bind 127.0.0.1 is the security model. Nothing here is authenticated
# because nothing off-box can reach it.
[Unit]
Description=Serve the kiosk dashboard on localhost
After=network.target

[Service]
ExecStart=/usr/bin/python3 -m http.server {{ kiosk_port }} --bind 127.0.0.1 --directory {{ kiosk_dir }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
