#!/usr/bin/env bash
# Managed by Ansible (pve_kiosk) — edits will be overwritten
#
# Writes one JSON blob for the dashboard to poll. Everything is read
# locally; the only outbound traffic is the two reachability probes.
set -euo pipefail

OUT="{{ kiosk_dir }}/data.json"
PREV="{{ kiosk_dir }}/.netprev"
TMP="$(mktemp "{{ kiosk_dir }}/.data.XXXXXX.json")"
trap 'rm -f "$TMP"' EXIT

# Each source fails independently — a wedged tailscaled must not blank the
# machine list, and a missing GPU must not stop anything at all.
grab() { "$@" 2>/dev/null || echo 'null'; }

HOST=$(grab pvesh get /nodes/{{ pve_node }}/status --output-format json)
GUESTS=$(grab pvesh get /nodes/{{ pve_node }}/qemu --output-format json)
LXC=$(grab pvesh get /nodes/{{ pve_node }}/lxc --output-format json)
TAILNET=$(grab tailscale status --json)

# ── reachability ──────────────────────────────────────────────────
# Two genuinely different things, so two probes. The tailnet can be fine
# while the internet is down (LAN peers still reachable), and the internet
# can be fine while the coordination server is down — in which case
# existing tailnet links keep working, because it never carried traffic.
if timeout 3 bash -c '</dev/tcp/8.8.8.8/53' 2>/dev/null; then NET=true; else NET=false; fi

CTL=$(curl -s -o /dev/null -w '%{http_code}' --max-time 4 "{{ headscale_server_url }}/health" 2>/dev/null || echo 000)
[ "$CTL" = "000" ] && CTL=$(curl -s -o /dev/null -w '%{http_code}' --max-time 4 "{{ headscale_server_url }}/" 2>/dev/null || echo 000)

# ── gpu (amdgpu; absent on boxes without one) ─────────────────────
# `|| echo GPU` on the pipeline appended a second line instead of
# replacing the first — grep -m1 makes the pipeline exit non-zero even
# when it matched, so both outputs ended up in the name.
GPUNAME=$(lspci 2>/dev/null | grep -iEm1 'vga|3d controller' \
  | sed -E 's/.*: //; s/ \(rev.*//; s/.*\[([^]]*)\]$/\1/' || true)
[ -z "$GPUNAME" ] && GPUNAME="GPU"

GPU=null
for d in /sys/class/drm/card*/device; do
  [ -r "$d/gpu_busy_percent" ] || continue
  GPU=$(jq -n \
    --argjson busy "$(cat "$d/gpu_busy_percent" 2>/dev/null || echo 0)" \
    --argjson used "$(cat "$d/mem_info_vram_used" 2>/dev/null || echo 0)" \
    --argjson total "$(cat "$d/mem_info_vram_total" 2>/dev/null || echo 0)" \
    --argjson temp "$(cat "$d"/hwmon/hwmon*/temp1_input 2>/dev/null | head -1 || echo 0)" \
    --arg name "$GPUNAME" \
    '{name:$name, busy:$busy, used:$used, total:$total, temp:($temp/1000|floor)}')
  break
done

# ── network rates ─────────────────────────────────────────────────
# /proc/net/dev is cumulative, so a rate needs the previous sample. First
# run after boot reports zero rather than a meaningless huge number.
NOW=$(date +%s)
declare -A RX TX
while read -r iface rx _ _ _ _ _ _ _ tx _; do
  iface="${iface%:}"
  case "$iface" in vmbr*|tailscale*|en*|eth*) RX[$iface]=$rx; TX[$iface]=$tx;; esac
done < <(tail -n +3 /proc/net/dev)

NETJSON="[]"
if [ -r "$PREV" ]; then
  PT=$(head -1 "$PREV")
  DT=$(( NOW - PT )); [ "$DT" -lt 1 ] && DT=1
  for i in "${!RX[@]}"; do
    line=$(grep "^$i " "$PREV" 2>/dev/null || true)
    [ -z "$line" ] && continue
    prx=$(echo "$line" | awk '{print $2}'); ptx=$(echo "$line" | awk '{print $3}')
    NETJSON=$(jq -c --arg n "$i" \
      --argjson rx "$(( (${RX[$i]} - prx) / DT ))" \
      --argjson tx "$(( (${TX[$i]} - ptx) / DT ))" \
      --argjson trx "${RX[$i]}" --argjson ttx "${TX[$i]}" \
      '. + [{name:$n, rx:(if $rx<0 then 0 else $rx end), tx:(if $tx<0 then 0 else $tx end), total_rx:$trx, total_tx:$ttx}]' \
      <<<"$NETJSON")
  done
fi
{ echo "$NOW"; for i in "${!RX[@]}"; do echo "$i ${RX[$i]} ${TX[$i]}"; done; } > "$PREV"

# ── filesystems ───────────────────────────────────────────────────
# /etc/pve is excluded: it is Proxmox's config fuse mount, always ~16 KB
# of a fixed 128 MB, and says nothing about disk pressure.
FS=$(df -B1 -x tmpfs -x devtmpfs -x efivarfs -x overlay --output=target,fstype,size,used 2>/dev/null \
  | tail -n +2 | grep -v '^/etc/pve ' \
  | jq -Rn '[inputs | split(" ") | map(select(length>0))
             | select(length>=4) | {mount:.[0], type:.[1], total:(.[2]|tonumber), used:(.[3]|tonumber)}]')

# ── things that want attention ────────────────────────────────────
UPDATES=$(apt list --upgradable 2>/dev/null | tail -n +2 \
  | jq -Rn '[inputs | select(length>0) | split("/") | {name:.[0],
      to:(.[1] | split(" ") | .[1] // ""),
      from:((.[1] // "") | capture("from: (?<v>[^]]+)").v // "")}]')

FAILED=$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null \
  | awk '{print $1}' | jq -Rn '[inputs | select(length>0)]')

jq -n \
  --arg     generated "$(date -Is)"                 \
  --arg     node      "{{ pve_node }}"              \
  --argjson host      "${HOST:-null}"               \
  --argjson guests    "${GUESTS:-null}"             \
  --argjson lxc       "${LXC:-null}"                \
  --argjson tailnet   "${TAILNET:-null}"            \
  --argjson gpu       "${GPU:-null}"                \
  --argjson net       "${NETJSON:-[]}"              \
  --argjson fs        "${FS:-[]}"                   \
  --argjson updates   "${UPDATES:-[]}"              \
  --argjson failed    "${FAILED:-[]}"               \
  --argjson internet  "$NET"                        \
  --arg     ctlurl    "{{ headscale_server_url }}"  \
  --argjson ctlcode   "${CTL:-0}"                   \
  '{generated:$generated, node:$node, host:$host, guests:$guests, lxc:$lxc,
    tailnet:$tailnet, gpu:$gpu, net:$net, fs:$fs, updates:$updates, failed:$failed,
    internet:$internet,
    control:{url:$ctlurl, code:$ctlcode, online:($ctlcode >= 200 and $ctlcode < 500)}}' \
  > "$TMP"

mv "$TMP" "$OUT"
chmod 0644 "$OUT"
trap - EXIT
