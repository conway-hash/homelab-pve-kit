# Managed by Ansible (pve_kiosk) — edits will be overwritten
#
# One unit where there used to be three: a oneshot collector, its timer,
# and python3 -m http.server. The daemon samples and serves in the same
# process because the history the graphs draw lives in its memory — split
# them and the server has nothing to serve but the newest snapshot, which
# is the arrangement this replaced.
[Unit]
Description=Kiosk dashboard: sampler and local web server
# pvesh talks to pmxcfs, so the guest panel is empty until this is up.
# tailscaled, because the dashboard also binds this host's tailnet address and
# that address does not exist until tailscaled has one. Ordering alone is not
# enough — systemd considers the unit started the moment the process is up, not
# when it has an address — which is why main() also waits. Without the ordering
# every boot starts by losing that race.
After=pve-cluster.service network.target tailscaled.service
Wants=pve-cluster.service tailscaled.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 {{ kiosk_dir }}/kioskd.py
Restart=always
RestartSec=3
# Root, unavoidably: `pvesh`, `qm guest exec` and the approve-an-upgrade
# actions all require it. The exposure is bounded by the bind address —
# the socket is on 127.0.0.1 and nothing forwards it.
User=root
# A sampler that leaks would take the hypervisor's RAM with it. The python
# process itself is about 30M with a full history window; the rest of this
# is the children, which the cgroup accounts for too — `apt-get -s
# dist-upgrade` alone peaks around 90M. Measured peak was 289M against an
# earlier 300M cap, which is close enough that a larger upgrade transaction
# would have started failing silently.
MemoryMax=512M
# The one file it writes is the now-playing line the lofi player leaves.
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
