<!doctype html>
<!-- Managed by Ansible (pve_kiosk) — edits will be overwritten -->
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ pve_node }}</title>
<style>
  /* Deliberately a terminal, not a dashboard. This screen replaced btop
     on tty1 and sits in a room, so: monospace throughout, square corners,
     no glow, no gradients, bars drawn with block characters. */
  :root{
    --line:#1e2321; --line2:#2c3330;
    --fg:#c6cdc6; --dim:#6f7a74; --faint:#454e4a;
    --green:#7fa66a; --amber:#c2954e; --red:#b5615c; --cyan:#5f97a1;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:var(--bg); color:var(--fg); overflow:hidden; cursor:none;
    font:15px/1.45 "DejaVu Sans Mono",ui-monospace,monospace;
    -webkit-font-smoothing:none;
  }
  #grid{
    height:100vh; display:grid; gap:1px; padding:1px; background:var(--line);
    grid-template-columns:minmax(330px,1fr) 1.55fr;
    grid-template-rows:auto 1fr auto;
    grid-template-areas:"head head" "host net" "vms net";
  }
  .p{background:var(--panel);padding:10px 14px;overflow:hidden}
  .p>h2{
    font-size:12px;color:var(--dim);font-weight:400;letter-spacing:.05em;
    padding-bottom:6px;margin-bottom:9px;border-bottom:1px solid var(--line2);
  }
  .p>h2::before{content:"── "}
  b{font-weight:400;color:var(--fg)}
  .num{font-variant-numeric:tabular-nums}

  /* header ------------------------------------------------------- */
  #head{grid-area:head;display:flex;align-items:baseline;gap:22px;padding:9px 14px}
  #host{font-size:20px;color:var(--cyan)}
  #host::before{content:"root@";color:var(--faint)}
  .kv{font-size:13px;color:var(--dim)}
  .kv b{color:var(--fg)}
  .kv.warn b{color:var(--amber)} .kv.bad b{color:var(--red)} .kv.ok b{color:var(--green)}
  #clock{margin-left:auto;font-size:20px;color:var(--dim)}

  /* host metrics -------------------------------------------------- */
  #host_p{grid-area:host}
  .m{display:flex;align-items:baseline;gap:9px;margin-bottom:5px;font-size:14px}
  .m .lbl{color:var(--dim);width:66px;flex:none}
  .m .g{letter-spacing:-1px;white-space:pre;color:var(--green)}
  .m .g.w{color:var(--amber)} .m .g.c{color:var(--red)}
  .m .v{margin-left:auto;color:var(--dim)}
  #cpuinfo{margin-top:10px;font-size:12px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

  /* machines ------------------------------------------------------ */
  #vms{grid-area:vms;overflow-y:auto}
  table{width:100%;border-collapse:collapse;font-size:14px}
  td{padding:3px 0}
  td.s{width:14px}
  td.k{color:var(--faint);font-size:12px;width:46px}
  td.r{text-align:right;color:var(--dim);font-size:13px;white-space:nowrap}
  .on{color:var(--green)} .off{color:var(--faint)}

  /* network ------------------------------------------------------- */
  #net{grid-area:net;display:flex;flex-direction:column}
  svg{flex:1;width:100%;min-height:0}
  text{font-family:"DejaVu Sans Mono",monospace}
  .ctl{stroke:var(--faint);stroke-width:1;stroke-dasharray:2 4}
  .lnk{stroke-width:1.5;fill:none}
  .lnk.direct{stroke:var(--green)}
  .lnk.relay{stroke:var(--amber);stroke-dasharray:6 4}
  .lnk.dead{stroke:var(--faint);stroke-dasharray:1 4}
  .nm{fill:var(--fg);font-size:12px;text-anchor:middle}
  .sub{fill:var(--dim);font-size:10px;text-anchor:middle}
  .note{fill:var(--faint);font-size:10px;text-anchor:middle}
  #key{font-size:11px;color:var(--dim);border-top:1px solid var(--line2);padding-top:7px;margin-top:4px}
  #key div{margin-bottom:2px}
  #key s{text-decoration:none;color:var(--green)}
  #key a{text-decoration:none;color:var(--amber)}
  #key u{text-decoration:none;color:var(--faint)}

  #stale{position:fixed;inset:0;background:rgba(11,13,12,.9);display:none;
         align-items:center;justify-content:center;color:var(--amber);font-size:18px}
</style>
</head>
<body>
<div id="grid">
  <div id="head" class="p">
    <span id="host">…</span>
    <span class="kv">up <b id="up">—</b></span>
    <span class="kv" id="updk">pkg <b id="upd">—</b></span>
    <span class="kv" id="tsk">tailnet <b id="ts">—</b></span>
    <span id="clock">--:--:--</span>
  </div>

  <div id="host_p" class="p">
    <h2>host</h2>
    <div id="metrics"></div>
    <div id="cpuinfo"></div>
  </div>

  <div id="vms" class="p">
    <h2>virtual machines &amp; containers</h2>
    <table id="vmt"></table>
  </div>

  <div id="net" class="p">
    <h2>tailnet</h2>
    <svg id="svg" viewBox="0 0 620 430" preserveAspectRatio="xMidYMid meet"></svg>
    <div id="key">
      <div><s>───</s> direct — packets go straight between the two machines</div>
      <div><a>╌╌╌</a> relayed — NAT blocked a direct path, so traffic detours
           through a public relay (still end-to-end encrypted, just slower)</div>
      <div><u>┈┈┈</u> control plane — headscale hands out keys and tells nodes
           about each other. <b>No traffic flows through it.</b></div>
    </div>
  </div>
</div>
<div id="stale">data is stale — collector not running?</div>

<script>
const REFRESH = {{ kiosk_refresh_seconds }} * 1000;
const CONTROL = "{{ headscale_server_url | regex_replace('^https?://', '') }}";
const NS = "http://www.w3.org/2000/svg";
const $ = i => document.getElementById(i);

const gib = b => (b/1073741824).toFixed(1)+"G";
const pct = (u,t) => (!t||t<=0) ? 0 : Math.min(100,(u/t)*100);
function dur(s){
  s=Math.floor(s||0);
  const d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);
  return d?`${d}d ${h}h`:h?`${h}h ${m}m`:`${m}m`;
}
// Block-character bars: this is meant to read as a terminal, and a text
// bar in a monospace grid does that in a way a styled <div> cannot.
function bar(p,w=26){
  const f=Math.round(p/100*w);
  return "█".repeat(f)+"░".repeat(Math.max(0,w-f));
}
function metric(lbl,p,val){
  const k = p>=90?"c":p>=70?"w":"";
  return `<div class="m"><span class="lbl">${lbl}</span>`+
         `<span class="g ${k}">${bar(p)}</span>`+
         `<span class="v num">${val}</span></div>`;
}
const mk=(t,a)=>{const n=document.createElementNS(NS,t);for(const k in a)n.setAttribute(k,a[k]);return n;};
const txt=(x,y,c,s)=>Object.assign(mk("text",{x,y,class:c}),{textContent:s});

function drawNet(ts){
  const svg=$("svg"); svg.replaceChildren();
  if(!ts||!ts.Self){ svg.append(txt(310,215,"sub","tailscale data unavailable")); return; }

  const self=ts.Self, peers=Object.values(ts.Peer||{});
  const nodes=[{p:self,self:true},...peers.map(p=>({p,self:false}))];

  // Nodes on one row; control plane above; observed links arced beneath.
  // A ring centred on this host would imply it sits at the middle of the
  // tailnet, which is exactly the wrong idea — it is one peer of several.
  const y=190, x0=70, span=(620-x0*2)/Math.max(1,nodes.length-1);
  nodes.forEach((n,i)=>n.x = nodes.length===1 ? 310 : x0+i*span);
  const cx=310, cy=52;

  svg.append(mk("rect",{x:cx-118,y:cy-19,width:236,height:38,fill:"none",stroke:"var(--faint)"}));
  svg.append(txt(cx,cy-2,"sub",CONTROL));
  svg.append(txt(cx,cy+12,"note","headscale · control plane"));
  nodes.forEach(n=>svg.append(mk("line",{x1:cx,y1:cy+19,x2:n.x,y2:y-22,class:"ctl"})));

  nodes.forEach(n=>{
    const p=n.p, online=p.Online||n.self;
    const relayed=!n.self && online && !!p.Relay && !p.CurAddr;
    svg.append(mk("rect",{x:n.x-30,y:y-22,width:60,height:44,fill:"none",
      stroke: n.self?"var(--cyan)":online?"var(--green)":"var(--faint)"}));
    svg.append(txt(n.x,y-4,"nm",(p.HostName||"?").slice(0,11)));
    svg.append(txt(n.x,y+11,"sub",(p.TailscaleIPs||[""])[0].replace("100.64.0.","·")));
    svg.append(txt(n.x,y+38,"sub",
      n.self ? "this host" : !online ? "offline" : relayed ? "relay "+p.Relay : "direct"));
  });

  // Only this node's own links are drawable: `tailscale status` here
  // reports pve<->peer and nothing about peer<->peer. Saying so beats
  // inventing edges that were never measured.
  const me=nodes.find(n=>n.self);
  nodes.filter(n=>!n.self).forEach(n=>{
    const p=n.p, online=p.Online;
    const relayed=online && !!p.Relay && !p.CurAddr;
    const dip=y+62+Math.abs(n.x-me.x)/14;
    svg.append(mk("path",{
      d:`M ${me.x} ${y+22} Q ${(me.x+n.x)/2} ${dip} ${n.x} ${y+22}`,
      class:"lnk "+(!online?"dead":relayed?"relay":"direct")}));
    if(relayed){
      const mx=(me.x+n.x)/2, my=y+22+(dip-(y+22))*0.5;
      svg.append(mk("rect",{x:mx-19,y:my-8,width:38,height:16,fill:"var(--panel)",stroke:"var(--amber)"}));
      svg.append(txt(mx,my+4,"sub",p.Relay));
    }
  });

  svg.append(txt(310,414,"note",
    "observed from this host only — links between the other peers are not visible here"));
}

function render(d){
  $("host").textContent=d.node||"?";
  const h=d.host;
  if(h){
    const cp=(h.cpu||0)*100, mp=pct(h.memory?.used,h.memory?.total), rp=pct(h.rootfs?.used,h.rootfs?.total);
    $("metrics").innerHTML=
      metric("cpu",cp,cp.toFixed(1)+"%")+
      metric("mem",mp,`${gib(h.memory?.used)}/${gib(h.memory?.total)}`)+
      metric("disk",rp,`${gib(h.rootfs?.used)}/${gib(h.rootfs?.total)}`)+
      `<div class="m"><span class="lbl">load</span><span class="v num">${(h.loadavg||[]).join("  ")}</span></div>`;
    $("cpuinfo").textContent=`${h.cpuinfo?.cpus||"?"} cores · ${h.cpuinfo?.model||""}`;
    $("up").textContent=dur(h.uptime);
  }

  const rows=[...(d.guests||[]).map(g=>({...g,k:"vm"})),...(d.lxc||[]).map(g=>({...g,k:"ct"}))]
             .sort((a,b)=>a.vmid-b.vmid);
  $("vmt").innerHTML = rows.length ? rows.map(g=>{
    const on=g.status==="running";
    return `<tr><td class="s ${on?"on":"off"}">${on?"●":"○"}</td>`+
      `<td>${g.name||"—"}</td><td class="k">${g.k} ${g.vmid}</td>`+
      `<td class="r num">${on?dur(g.uptime)+"  "+gib(g.mem)+"/"+gib(g.maxmem):g.status}</td></tr>`;
  }).join("") : `<tr><td class="k">none</td></tr>`;

  const u=d.updates|0;
  $("upd").textContent = u ? u+" pending" : "current";
  $("updk").className = "kv "+(u?"warn":"ok");

  const st=d.tailnet?.BackendState||"unknown";
  $("ts").textContent=st.toLowerCase();
  $("tsk").className="kv "+(st==="Running"?"ok":"bad");

  drawNet(d.tailnet);
  $("stale").style.display=((Date.now()-new Date(d.generated).getTime())/1000 > REFRESH/1000*4)?"flex":"none";
}

async function tick(){
  try{ const r=await fetch("data.json?t="+Date.now(),{cache:"no-store"}); if(r.ok) render(await r.json()); }
  catch(e){}
}
setInterval(()=>$("clock").textContent=new Date().toLocaleTimeString(),1000);
tick(); setInterval(tick,REFRESH);
</script>
</body>
</html>
