<!doctype html>
<!-- Managed by Ansible (pve_kiosk) — edits will be overwritten -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ pve_node }}</title>
<style>
/* One colour per resource, so a graph is identifiable without reading its
   label. Red is NOT in that set — it is reserved for a threshold being hit,
   which is why nothing is red until something is wrong. */
:root{
  --bg:#080b11; --card:#101722; --card2:#0c121a; --box:#0a1017;
  --line:#1e2836; --line2:#161e29;
  --fg:#dde5f0; --mut:#8494a8; --dim:#41505f;
  --cpu:#4c9aff; --gpu:#48c4d8; --mem:#4ec9a5;
  --dn:#e07ab0; --up:#9b8cff; --sto:#e0913f;
  --good:#4ec9a5; --warn:#e0a34a; --bad:#e05c5c;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:radial-gradient(1200px 640px at 78% -16%,#131e2c 0%,transparent 60%),var(--bg);
     color:var(--fg);overflow:hidden;font:13px/1.5 "DejaVu Sans",system-ui,sans-serif}
.mono{font-family:"DejaVu Sans Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}

#app{height:100vh;display:grid;gap:10px;padding:10px;
     grid-template-columns:352px minmax(0,1.05fr) minmax(0,1.5fr) minmax(0,.5fr);
     grid-template-rows:auto minmax(0,1fr) minmax(0,1fr);
     grid-template-areas:
       "top top  top   top"
       "sys vms  tnet  tnet"
       "sys vms  logs  notif";}
.card{background:linear-gradient(180deg,var(--card),var(--card2));border:1px solid var(--line);
      border-radius:11px;padding:12px 14px;overflow:hidden;position:relative;
      display:flex;flex-direction:column;min-height:0}
.t{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);
   margin-bottom:10px;display:flex;align-items:center;gap:9px;flex:none}
.t::after{content:"";flex:1;height:1px;background:var(--line)}
.scroll{overflow-y:auto;flex:1;min-height:0;scrollbar-width:thin;
        scrollbar-color:var(--line) transparent}

/* ── header ───────────────────────────────────────────────────── */
#top{grid-area:top;display:grid;grid-template-columns:1fr auto 1fr;
     align-items:center;padding:9px 16px;gap:10px}
#brand{font-size:19px;font-weight:600;color:var(--fg);white-space:nowrap}
#brand em{font-style:normal;color:var(--dim);font-weight:400;margin-left:7px;font-size:13px}
#pills{justify-self:center;display:flex;gap:8px;align-items:center;flex-wrap:wrap;
       justify-content:center}
.pill{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--mut);
      background:#0b1118;border:1px solid var(--line);border-radius:99px;
      padding:5px 11px;white-space:nowrap}
.pill b{font-weight:600;color:var(--fg)}
button.pill{font:inherit;font-size:11.5px;cursor:pointer}
button.pill:hover{border-color:var(--fg)}
.led{width:7px;height:7px;border-radius:50%;background:var(--dim);flex:none}
.led.ok{background:var(--good)}
.led.warn{background:var(--warn)}
.led.bad{background:var(--bad);animation:blink 1.1s steps(1,end) infinite}
@keyframes blink{50%{opacity:.25}}
#when{justify-self:end;text-align:right;line-height:1.12}
#clock{font-size:30px;font-weight:600;letter-spacing:-.01em}
#date{font-size:15px;font-weight:500;color:var(--mut)}
#date b{color:var(--fg);font-weight:600}

/* ── one dark box per resource ────────────────────────────────── */
#sys{grid-area:sys}
.blk{background:var(--box);border:1px solid var(--line2);border-radius:8px;
     padding:10px 12px;margin-bottom:9px}
.blk:last-child{margin-bottom:2px}
.bh{display:flex;align-items:baseline;gap:8px}
.bh .l{font-size:11px;letter-spacing:.16em;text-transform:uppercase;
       font-weight:600;flex:none}
.bh .hw{margin-left:auto;font-size:10px;color:var(--dim);
        overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.big{font-size:25px;font-weight:600;line-height:1.15;margin:2px 0 4px}
.big small{font-size:12px;color:var(--mut);font-weight:400;margin-left:2px}
.big .side{float:right;font-size:12px;color:var(--mut);font-weight:400;margin-top:10px}
.big .side b{color:var(--fg);font-weight:600}
.chart{width:100%;display:block}

/* Two fixed columns, tabular values. A number going from 9 W to 146 W moves
   nothing else — the GPU rows used to reflow while being read. */
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
       gap:1px 12px;margin-top:5px}
.stats div{display:flex;justify-content:space-between;gap:6px;
           font-size:10.5px;color:var(--mut);white-space:nowrap}
.stats b{color:var(--fg);font-weight:600;
         font-family:"DejaVu Sans Mono",ui-monospace,monospace;
         font-variant-numeric:tabular-nums}

.trk{height:5px;background:#070b10;border-radius:3px;overflow:hidden}
.trk>i{display:block;height:100%;border-radius:3px;width:0;
       transition:width .6s ease,background .4s}

#cores{display:grid;grid-template-columns:repeat(6,1fr);gap:3px;margin-top:7px}
.core{background:#070c12;border:1px solid var(--line2);border-radius:4px;
      position:relative;overflow:hidden;height:29px;
      display:flex;align-items:center;justify-content:center}
.core i{position:absolute;left:0;bottom:0;width:100%;opacity:.24;transition:height .35s linear}
.core u{font-style:normal;text-decoration:none;font-size:8px;color:var(--dim);
        position:absolute;top:1px;left:3px}
.core span{font-size:11px;font-weight:600;position:relative;z-index:1}

.nrow{margin-bottom:7px}
.nrow:last-child{margin-bottom:0}
.nrow .hd{display:flex;align-items:baseline;gap:7px;font-size:10.5px;color:var(--mut)}
.nrow .hd b{margin-left:auto;color:var(--fg);font-weight:600;
            font-family:"DejaVu Sans Mono",ui-monospace,monospace;
            font-variant-numeric:tabular-nums}

.fs{margin-bottom:9px}
.fs:last-child{margin-bottom:0}
.fs .r1{display:flex;align-items:baseline;gap:7px;font-size:12px}
.fs .r1 .ty{font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:var(--dim);
            border:1px solid var(--line);border-radius:3px;padding:0 4px}
.fs .r1 .pc{margin-left:auto;font-weight:600;color:var(--fg)}
.fs .r2{font-size:10.5px;color:var(--mut);display:flex;gap:8px;margin-top:3px}
.fs .r2 .dev{color:var(--dim);margin-left:auto}

/* ── guests ───────────────────────────────────────────────────── */
#vms{grid-area:vms}
#tabs{display:flex;gap:5px;margin-bottom:9px;flex:none}
.tab{flex:1;border:1px solid var(--line);background:var(--box);border-radius:7px;
     padding:9px 10px;cursor:pointer;text-align:left;color:var(--mut);
     font:inherit;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
     transition:color .2s,border-color .2s,opacity .2s}
.tab b{display:block;font-size:17px;letter-spacing:0;color:var(--fg);font-weight:600}
/* White, not blue: selection is not a measurement, and blue is the CPU. */
.tab.on{border-color:var(--fg);color:var(--fg)}
.tab.empty{opacity:.34}
.tab.empty b{color:var(--dim)}

.g{background:var(--box);border:1px solid var(--line2);border-radius:8px;
   padding:10px 12px;margin-bottom:9px}
.g.off{opacity:.55}
.gh{display:flex;align-items:center;gap:7px}
.gh .n{font-weight:600;font-size:14px}
.gh .up{margin-left:auto;font-size:10.5px;color:var(--mut)}
.tag{font-size:9px;letter-spacing:.07em;text-transform:uppercase;color:var(--mut);
     border:1px solid var(--line);border-radius:4px;padding:0 5px}
.gdns{font-size:10px;color:var(--dim);margin-bottom:7px}
/* Divided off from the resource rows above it: those are "how is it doing
   right now", this is "could you get it back". Different question, and on a
   password vault the more important one. */
.bk{display:flex;align-items:center;gap:7px;margin-top:8px;padding-top:8px;
    border-top:1px solid var(--line)}
.bk .k{font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut)}
.bk .bv{font-size:10.5px;margin-left:auto;
        font-family:"DejaVu Sans Mono",ui-monospace,monospace;
        font-variant-numeric:tabular-nums}
/* label · percent · bar · ceiling. The ceiling column is sized to content
   and right-aligned, so rows line up and nothing stretches. */
.vrow{display:grid;grid-template-columns:30px 40px minmax(0,1fr) auto;
      gap:8px;align-items:center;margin-bottom:5px}
.vrow:last-child{margin-bottom:0}
.vrow .k{font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut)}
.vrow .pcv,.vrow .rt{font-size:11px;
     font-family:"DejaVu Sans Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}
.vrow .pcv{color:var(--fg);text-align:right}
.vrow .rt{color:var(--mut);text-align:right;white-space:nowrap}
.ctrs{margin-top:8px;border-top:1px solid var(--line2);padding-top:7px;
      display:flex;flex-wrap:wrap;gap:4px}
.ctr{display:flex;align-items:center;gap:5px;font-size:10.5px;color:var(--fg);
     background:#0c131b;border:1px solid var(--line2);border-radius:5px;padding:2px 6px}
.empty-note{color:var(--dim);font-size:12px;text-align:center;padding:28px 0}

/* ── tailnet ──────────────────────────────────────────────────── */
#tnet{grid-area:tnet}
#tnwrap{flex:1;display:grid;grid-template-columns:3fr minmax(0,1fr);gap:12px;min-height:0}
#msvg{width:100%;height:100%;min-height:0}
#tndetail{background:var(--box);border:1px solid var(--line2);border-radius:8px;
          padding:9px 10px;overflow-y:auto;font-size:10.5px;
          scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.dh{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);
    margin-bottom:5px}
.drow{margin-bottom:8px;padding-bottom:7px;border-bottom:1px solid var(--line2)}
.drow:last-child{border-bottom:0;margin-bottom:0;padding-bottom:0}
.drow .nm{display:flex;align-items:center;gap:5px;font-weight:600;color:var(--fg);
          font-size:11px}
.drow .dns{color:var(--mut);word-break:break-all;line-height:1.45}
.drow .ex{color:var(--dim)}
.edge{fill:none;stroke-linecap:round}
.e-direct{stroke:var(--good);stroke-width:1.9;opacity:.8}
.e-relay{stroke:var(--warn);stroke-width:1.9;stroke-dasharray:6 5;opacity:.85;
         animation:flow 1.4s linear infinite}
@keyframes flow{to{stroke-dashoffset:-11}}
.e-off{stroke:var(--dim);stroke-width:1.1;stroke-dasharray:2 5;opacity:.5}
.ico{fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.hull{fill:var(--fg);fill-opacity:.035;stroke:var(--fg);stroke-opacity:.22;
      stroke-width:1;stroke-dasharray:4 4}
.hull-l{fill:var(--fg);font-size:9px;opacity:.45;letter-spacing:.1em}
.nlbl{fill:var(--fg);font-size:11.5px;font-weight:600}
.nlink{font-size:9.5px}

/* ── logs & alerts ────────────────────────────────────────────── */
#logs{grid-area:logs}
#notif{grid-area:notif}
.lgh,.lg{display:grid;grid-template-columns:46px 60px 90px minmax(0,1fr);
         gap:8px;align-items:baseline}
.lgh{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);
     padding-bottom:4px;border-bottom:1px solid var(--line);margin-bottom:2px;flex:none}
.lg{padding:4px 0;font-size:10.5px;border-bottom:1px solid var(--line2)}
.lg:last-child{border-bottom:0}
.lg .tm{color:var(--dim);font-family:"DejaVu Sans Mono",ui-monospace,monospace}
.lg .src,.lg .who{color:var(--mut);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lg .ms{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--fg)}
.lg.bad .ms{color:var(--bad)} .lg.warn .ms{color:var(--warn)}

.al{display:flex;gap:8px;padding:7px 0;border-bottom:1px solid var(--line2);font-size:11.5px}
.al:last-child{border-bottom:0}
.al .ic{flex:none;width:14px;text-align:center}
.al .tx{flex:1;min-width:0}
.al .tx b{display:block;font-weight:600;font-size:12px;margin-bottom:1px}
.al .tx span{color:var(--mut);font-size:10.5px;display:block}
.ok-note{color:var(--good);font-size:12px;display:flex;gap:8px;align-items:center;padding:10px 0}
.btn{font:inherit;font-size:10.5px;background:#0d141c;border:1px solid var(--line);
     color:var(--fg);border-radius:6px;padding:5px 11px;cursor:pointer;position:relative;
     overflow:hidden;margin:6px 6px 0 0}
.btn:hover{border-color:var(--fg)}
.btn.danger:hover{border-color:var(--bad)}
.btn i{position:absolute;left:0;top:0;bottom:0;width:0;background:var(--fg);opacity:.22}
.btn.danger i{background:var(--bad)}
.btn span{position:relative}
/* Offered but not usable from here — see the daemon's action reach rules. */
.btn[disabled]{opacity:.4;cursor:default;border-style:dashed}
.btn[disabled]:hover{border-color:var(--line)}

#stale{position:fixed;inset:0;background:rgba(8,11,17,.94);display:none;
       align-items:center;justify-content:center;color:var(--warn);font-size:19px;z-index:9}

/* ── phones and laptops ───────────────────────────────────────── */
/* Same page, same content, one column. The four-column grid assumes a
   monitor; below this it becomes a scroll. */
@media (max-width:900px){
  body{overflow:auto}
  #app{height:auto;min-height:100vh;grid-template-columns:minmax(0,1fr);
       grid-template-rows:none;
       grid-template-areas:"top" "sys" "vms" "tnet" "logs" "notif";}
  .card{overflow:visible}
  #top{grid-template-columns:minmax(0,1fr);justify-items:center;text-align:center;gap:8px}
  #when{justify-self:center;text-align:center}
  #clock{font-size:34px}
  .scroll{overflow:visible;max-height:none}
  #sys .scroll{overflow:visible}
  #tnwrap{grid-template-columns:minmax(0,1fr);grid-template-rows:260px auto}
  #logs .scroll,#notif .scroll{max-height:60vh;overflow-y:auto}
  #cores{grid-template-columns:repeat(4,1fr)}
  .lgh,.lg{grid-template-columns:44px 56px minmax(0,1fr);}
  .lgh span:nth-child(3),.lg .who{display:none}
}
</style>
</head>
<body>
<div id="app">

  <div id="top" class="card">
    <div id="brand">Proxmox VE<em id="nodename"></em></div>
    <div id="pills">
      <div class="pill"><span class="led" id="l_net"></span>internet <b id="v_net">—</b></div>
      <div class="pill"><span class="led" id="l_ts"></span>tailnet <b id="v_ts">—</b></div>
      <div class="pill"><span class="led" id="l_ctl"></span>headscale <b id="v_ctl">—</b></div>
      <div class="pill">uptime <b id="v_up">—</b></div>
      <div class="pill" id="p_boot" style="display:none"><span class="led warn"></span>reboot pending</div>
    </div>
    <div id="when">
      <div id="clock" class="mono">--:--:--</div>
      <div id="date">—</div>
    </div>
  </div>

  <div id="sys" class="card">
    <div class="t">system</div>
    <div class="scroll">

      <div class="blk">
        <div class="bh"><span class="l" style="color:var(--cpu)">cpu</span>
          <span class="hw" id="cpu_hw">—</span></div>
        <div class="big mono"><span id="cpu_v">0.0</span><small>%</small>
          <span class="side">temp <b id="cpu_t">—</b></span></div>
        <svg class="chart" id="c_cpu" height="48" preserveAspectRatio="none"></svg>
        <div id="cores"></div>
      </div>

      <div class="blk" id="gpu_blk">
        <div class="bh"><span class="l" style="color:var(--gpu)">gpu</span>
          <span class="hw" id="gpu_hw">—</span></div>
        <div class="big mono"><span id="gpu_v">0</span><small>%</small>
          <span class="side">temp <b id="gpu_t">—</b></span></div>
        <svg class="chart" id="c_gpu" height="42" preserveAspectRatio="none"></svg>
        <div class="stats" id="gpu_stats"></div>
      </div>

      <div class="blk">
        <div class="bh"><span class="l" style="color:var(--mem)">memory</span>
          <span class="hw" id="mem_hw">—</span></div>
        <div class="big mono"><span id="mem_used">—</span>
          <small> used of <span id="mem_total">—</span></small>
          <span class="side"><b id="mem_v">0</b>%</span></div>
        <svg class="chart" id="c_mem" height="42" preserveAspectRatio="none"></svg>
        <div class="stats" id="mem_stats"></div>
      </div>

      <div class="blk">
        <div class="bh"><span class="l">network</span><span class="hw" id="net_hw">—</span></div>
        <div class="nrow">
          <div class="hd"><span style="color:var(--dn)">download</span><b id="nd_v">—</b></div>
          <svg class="chart" id="c_down" height="38" preserveAspectRatio="none"></svg>
        </div>
        <div class="nrow">
          <div class="hd"><span style="color:var(--up)">upload</span><b id="nu_v">—</b></div>
          <svg class="chart" id="c_up" height="38" preserveAspectRatio="none"></svg>
        </div>
        <div class="stats" id="net_stats"></div>
      </div>

      <div class="blk">
        <div class="bh"><span class="l" style="color:var(--sto)">storage</span></div>
        <div id="fs_rows" style="margin-top:7px"></div>
      </div>

    </div>
  </div>

  <div id="vms" class="card">
    <div class="t">machines</div>
    <div id="tabs"></div>
    <div class="scroll" id="glist"></div>
  </div>

  <div id="tnet" class="card">
    <div class="t">tailnet</div>
    <div id="tnwrap">
      <svg id="msvg" preserveAspectRatio="xMidYMid meet"></svg>
      <div id="tndetail"></div>
    </div>
  </div>

  <div id="logs" class="card">
    <div class="t">logs</div>
    <div class="lgh"><span>time</span><span>source</span><span>who</span><span>what</span></div>
    <div class="scroll" id="loglist"></div>
  </div>

  <div id="notif" class="card">
    <div class="t">alerts</div>
    <div class="scroll" id="alist"></div>
  </div>

</div>
<div id="stale">data is stale — collector not running?</div>

<script>
const FAST={{ kiosk_poll_seconds }}*1000, SLOW={{ kiosk_poll_seconds }}*1000;
const NET_MAX={{ kiosk_net_scale_bytes }}, NET_IF="{{ kiosk_net_primary }}";
const NS="http://www.w3.org/2000/svg", $=i=>document.getElementById(i);
const C={cpu:"#4c9aff",gpu:"#48c4d8",mem:"#4ec9a5",dn:"#e07ab0",up:"#9b8cff",
         sto:"#e0913f",warn:"#e0a34a",bad:"#e05c5c"};
const RELAY={ams:"Amsterdam",blr:"Bangalore",bom:"Mumbai",cdg:"Paris",den:"Denver",dfw:"Dallas",
 dub:"Dublin",fra:"Frankfurt",hel:"Helsinki",hkg:"Hong Kong",ist:"Istanbul",jnb:"Johannesburg",
 lax:"Los Angeles",lhr:"London",lis:"Lisbon",mad:"Madrid",mia:"Miami",mil:"Milan",muc:"Munich",
 nrt:"Tokyo",nue:"Nuremberg",nyc:"New York",ord:"Chicago",par:"Paris",prg:"Prague",sao:"São Paulo",
 sea:"Seattle",sfo:"San Francisco",sin:"Singapore",sto:"Stockholm",syd:"Sydney",tor:"Toronto",
 vie:"Vienna",waw:"Warsaw",zrh:"Zurich"};

const ICON={
  server :["M3 4.5h18v6H3z","M3 13.5h18v6H3z","M6.4 7.5h.2","M6.4 16.5h.2"],
  vm     :["M2.5 5h19v14h-19z","M7.5 9h9v6h-9z"],
  pi     :["M3 6.5h18v11H3z","M6 6.5v2.5","M8 6.5v2.5","M10 6.5v2.5","M12 6.5v2.5","M8 12h7v4H8z"],
  laptop :["M5.5 5h13v9.5h-13z","M2.5 17.5h19l-2.5-3H5z"],
  phone  :["M8 3h8v18H8z","M10.8 18.2h2.4"],
  desktop:["M3 5h18v11H3z","M9 20h6","M12 16v4"],
};
const LOCK=["M6.5 11h11v9h-11z","M9 11V8.2a3 3 0 0 1 6 0V11"];

/* ── formatting ───────────────────────────────────────────────── */
const esc=s=>String(s??"").replace(/[<>&"]/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;",'"':"&quot;"}[c]));
function bytes(b){b=b||0;
  if(b>=1099511627776)return (b/1099511627776).toFixed(2)+" TiB";
  if(b>=1073741824)   return (b/1073741824).toFixed(b>=10737418240?0:1)+" GiB";
  if(b>=1048576)      return (b/1048576).toFixed(0)+" MiB";
  return (b/1024).toFixed(0)+" KiB";}
function rate(b){b=b||0;
  if(b>=1048576)return (b/1048576).toFixed(1)+" MB/s";
  if(b>=1024)   return (b/1024).toFixed(0)+" kB/s";
  return b+" B/s";}
function dur(s){s=Math.floor(s||0);const d=s/86400|0,h=s%86400/3600|0,m=s%3600/60|0;
  return d?`${d}d ${h}h`:h?`${h}h ${m}m`:`${m}m`;}
const pc=(u,t)=>(!t||t<=0)?0:Math.min(100,u/t*100);
/* A bar keeps its resource's colour until the top tenth, where it goes red.
   That is the only thing red ever means on this page. */
const barCol=(p,base)=>p>=90?C.bad:p>=75?C.warn:base;
const mk=(t,a)=>{const n=document.createElementNS(NS,t);for(const k in a)n.setAttribute(k,a[k]);return n;};
const txt=(x,y,c,s,f)=>{const n=mk("text",{x,y,class:c});if(f)n.setAttribute("fill",f);
  n.textContent=s;return n;};
function icon(paths,x,y,size,colour){
  const g=mk("g",{transform:`translate(${x-size/2} ${y-size/2}) scale(${size/24})`});
  for(const d of paths)g.append(mk("path",{d,class:"ico",stroke:colour}));
  return g;
}
function keepScroll(id,fn){const el=$(id),top=el.scrollTop;fn();el.scrollTop=top;}
const tw={};
function num(id,to,dp=1){
  const el=$(id); if(!el)return;
  const from=tw[id]??to,t0=performance.now(),D=500; tw[id]=to;
  (function step(t){const k=Math.min(1,(t-t0)/D),e=1-Math.pow(1-k,3);
    el.textContent=(from+(to-from)*e).toFixed(dp); if(k<1)requestAnimationFrame(step);})(t0);
}

/* ── charts ───────────────────────────────────────────────────── */
const MAXPT=190;
function stride(a){if(a.length<=MAXPT)return a;
  const out=[],k=a.length/MAXPT;
  for(let i=0;i<MAXPT;i++)out.push(a[Math.min(a.length-1,Math.round(i*k))]);
  return out;}

function chart(id,arr,max,colour){
  const svg=$(id); if(!svg)return;
  const W=1000,H=Number(svg.getAttribute("height"))||42;
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`); svg.replaceChildren();
  const v=stride(arr||[]);
  if(v.length<2){svg.append(txt(8,H/2+3,"nlink","collecting…","#41505f"));return;}
  const st=W/(v.length-1);
  const y=n=>H-1.5-(Math.min(Math.max(n,0),max)/max)*(H-3);
  const pt=v.map((n,i)=>[i*st,y(n)]);
  const d=pt.map((p,i)=>(i?"L":"M")+p[0].toFixed(1)+" "+p[1].toFixed(1)).join("");
  const gid=id+"_g",gr=mk("linearGradient",{id:gid,x1:0,y1:0,x2:0,y2:1});
  gr.append(mk("stop",{offset:"0%","stop-color":colour,"stop-opacity":".34"}),
            mk("stop",{offset:"100%","stop-color":colour,"stop-opacity":"0"}));
  svg.append(gr);
  for(const f of [.25,.5,.75])
    svg.append(mk("line",{x1:0,y1:H*f,x2:W,y2:H*f,stroke:"var(--line2)","stroke-width":1}));
  svg.append(mk("path",{d:`${d}L${W} ${H}L0 ${H}Z`,fill:`url(#${gid})`,stroke:"none"}),
             mk("path",{d,fill:"none",stroke:colour,"stroke-width":1.6,
                        "stroke-linejoin":"round","vector-effect":"non-scaling-stroke"}),
             mk("circle",{cx:pt.at(-1)[0],cy:pt.at(-1)[1],r:2.6,fill:colour}));
}

/* ── series store ─────────────────────────────────────────────── */
const S={}; let lastSeq=null, KEEPN=600;
function merge(p){
  KEEPN=p.keep||KEEPN;
  for(const k in p.series){
    const inc=p.series[k],cur=S[k];
    if(cur && inc.from===cur.from+cur.v.length && inc.v.length){
      cur.v.push(...inc.v);
      if(cur.v.length>KEEPN){cur.from+=cur.v.length-KEEPN;cur.v=cur.v.slice(-KEEPN);}
    }else if(!cur || inc.v.length){
      S[k]={from:inc.from,v:inc.v.slice()};
    }
  }
  lastSeq=p.seq;
}
const sv=k=>(S[k]?.v)||[];
const cell=(label,value)=>`<div><span>${label}</span><b>${value}</b></div>`;

/* ── fast panel ───────────────────────────────────────────────── */
let coreCells=[];
function renderFast(p){
  const n=p.now||{}; if(!n.mem)return;

  $("cpu_hw").textContent=n.cpu_model||"";
  num("cpu_v",n.cpu||0);
  const t=(n.temps||[])[0];
  $("cpu_t").textContent=t?t.c.toFixed(0)+"°C":"—";
  chart("c_cpu",sv("cpu"),100,C.cpu);

  const per=n.per_core||[];
  if(coreCells.length!==per.length){
    $("cores").replaceChildren();
    coreCells=per.map((_,i)=>{
      const d=document.createElement("div");d.className="core";
      d.innerHTML=`<i></i><u>${i}</u><span class="mono">0</span>`;
      $("cores").append(d);
      return {bar:d.querySelector("i"),val:d.querySelector("span")};
    });
  }
  per.forEach((v,i)=>{const c=coreCells[i];
    c.bar.style.height=v+"%"; c.bar.style.background=barCol(v,C.cpu);
    c.val.textContent=Math.round(v);});

  const g=n.gpu;
  $("gpu_blk").style.display=g?"":"none";
  if(g){
    $("gpu_hw").textContent=g.name||"";
    num("gpu_v",g.busy||0,0);
    $("gpu_t").textContent=g.temp.toFixed(0)+"°C";
    chart("c_gpu",sv("gpu"),100,C.gpu);
    $("gpu_stats").innerHTML=
      cell("vram",`${pc(g.vram_used,g.vram_total).toFixed(0)}%`)+
      cell("power",`${g.watts.toFixed(0)} W`)+
      cell("fan",`${g.fan_rpm} rpm`)+
      cell("clock",`${g.sclk} MHz`);
  }

  const m=n.mem,mp=pc(m.used,m.total),hw=n.mem_hw||{};
  $("mem_hw").textContent=hw.label||bytes(m.total);
  $("mem_used").textContent=bytes(m.used);
  $("mem_total").textContent=bytes(m.total);
  num("mem_v",mp,0);
  chart("c_mem",sv("mem"),100,C.mem);
  $("mem_stats").innerHTML=
    cell("free",bytes(m.available))+
    cell("cache",bytes(m.cached))+
    cell("swap",m.swap_total?`${pc(m.swap_used,m.swap_total).toFixed(0)}%`:"off")+
    cell("sticks",hw.detail||"—");

  const nets=n.net||{}, prim=nets[NET_IF]||{rx:0,tx:0,total_rx:0,total_tx:0};
  const ts=nets["tailscale0"];
  $("net_hw").textContent=NET_IF+" · full scale "+rate(NET_MAX);
  $("nd_v").textContent=rate(prim.rx);
  $("nu_v").textContent=rate(prim.tx);
  chart("c_down",sv("rx_"+NET_IF),NET_MAX,C.dn);
  chart("c_up",sv("tx_"+NET_IF),NET_MAX,C.up);
  $("net_stats").innerHTML=
    cell("total down",bytes(prim.total_rx))+
    cell("total up",bytes(prim.total_tx))+
    cell("tunnel down",ts?rate(ts.rx):"—")+
    cell("tunnel up",ts?rate(ts.tx):"—");

  $("v_up").textContent=dur(n.uptime);
}

/* ── guests ───────────────────────────────────────────────────── */
const GROUPS=[["automated","automated"],["manual","manual"],["template","templates"]];
let tab="automated", guests=[], canControl=true;

/* Built once, then updated in place. Rebuilding the strip on every refresh
   was the bug: a click only fires when press and release land on the SAME
   element, so any rebuild in between silently ate it — which is why these
   never responded while the hold-to-reboot button, which listens for
   pointerdown on the document, always did. */
function buildTabs(){
  $("tabs").replaceChildren(...GROUPS.map(([k,label])=>{
    const b=document.createElement("button");
    b.className="tab"; b.dataset.tab=k;
    b.innerHTML=`${label}<b>0</b>`;
    return b;
  }));
}
function paintTabs(){
  for(const b of $("tabs").children){
    const k=b.dataset.tab,count=guests.filter(g=>g.group===k).length;
    b.querySelector("b").textContent=count;
    b.className="tab"+(k===tab?" on":"")+(count?"":" empty");
  }
}
/* Delegated, and on pointerdown — the one event this browser is proven to
   deliver, since the reboot button has always worked. */
$("tabs").addEventListener("pointerdown",e=>{
  const b=e.target.closest(".tab"); if(!b)return;
  tab=b.dataset.tab; paintTabs(); renderGuests();
});

/* Templated from kiosk_backup_warn_hours / kiosk_backup_bad_hours rather than
   hardcoded, because they only mean anything relative to the backup SCHEDULE.
   They were 36h and 72h while backups ran nightly; the move to weekly would
   have left every card permanently red — an alarm that means nothing, which
   is worse than no alarm at all. Both live beside the schedule they track. */
const BK_WARN={{ kiosk_backup_warn_hours }}*3600, BK_BAD={{ kiosk_backup_bad_hours }}*3600;

function backupLine(g){
  const b=g.backup;
  if(!b||!b.last)
    return `<div class="bk"><span class="k">backup</span>
      <span class="led" style="background:${g.template?"var(--dim)":"var(--warn)"}"></span>
      <span class="bv" style="color:${g.template?"var(--dim)":"var(--warn)"}">never</span></div>`;
  const age=(Date.now()/1000)-b.last, failed=b.ok===false;
  // A template still gets swept up by a whole-node job, so it genuinely has
  // archives and saying "n/a" would be a lie. But freshness is not a
  // meaningful question about an image that changes once a year, so it is
  // shown without a verdict — the facts, in grey, and no alert.
  const col=g.template?"var(--dim)"
    :(failed||age>BK_BAD)?"var(--bad)":age>BK_WARN?"var(--warn)":"var(--good)";
  const txt=failed
    ? `failed · last good ${dur(age)} ago`
    : `${dur(age)} ago · ${bytes(b.size)} · ${b.count} kept`;
  return `<div class="bk"><span class="k">backup</span>
    <span class="led" style="background:${col}"></span>
    <span class="bv" style="color:${col==="var(--good)"?"var(--mut)":col}">${txt}</span></div>`;
}

function guestCard(g){
  const on=g.running, m=g.memory||{}, mp=pc(m.used,m.total), a=g.alloc||{};
  const fs=(g.fs||[]).filter(f=>f.mount==="/")[0]||(g.fs||[])[0];
  const dp=fs?pc(fs.used,fs.total):0;
  const row=(label,p,right,base)=>
    `<div class="vrow"><span class="k">${label}</span>
      <span class="pcv">${p.toFixed(0)}%</span>
      <div class="trk"><i style="width:${p}%;background:${barCol(p,base)}"></i></div>
      <span class="rt">${right}</span></div>`;
  const ctrs=(g.containers||[]).map(c=>{
    const col=c.state!=="running"?"var(--dim)":c.warn?"var(--warn)":"var(--good)";
    return `<span class="ctr"><span class="led" style="background:${col}"></span>${esc(c.name)}</span>`;
  }).join("");
  return `<div class="g${on?"":" off"}">
    <div class="gh"><span class="led ${on?"ok":""}"></span>
      <span class="n">${esc(g.name)}</span>
      <span class="tag">${g.kind} ${g.vmid}</span>
      ${g.tags.map(t=>`<span class="tag">${esc(t)}</span>`).join("")}
      <span class="up">${on?dur(g.uptime):esc(g.status)}</span></div>
    <div class="gdns">${esc(g.dns||"—")}</div>`+
    (on?row("cpu",g.cpu,`${a.cores} vcpu`,C.cpu)+
        row("ram",mp,bytes(m.total||a.memory),C.mem)+
        (fs?row("disk",dp,bytes(fs.total),C.sto):"")+
        (m.source==="host-rss"?`<div class="gdns" style="color:var(--warn);margin-top:6px">
           no balloon driver — this is the QEMU process's host memory, which overstates it</div>`:"")+
        (ctrs?`<div class="ctrs">${ctrs}</div>`:"")
      :"")+backupLine(g)+`</div>`;
}

function renderGuests(){
  const rows=guests.filter(g=>g.group===tab);
  keepScroll("glist",()=>{
    $("glist").innerHTML=rows.length?rows.map(guestCard).join("")
      :`<div class="empty-note">no machines in this group</div>`;});
}

/* ── tailnet ──────────────────────────────────────────────────── */
const POS={};
function layout(nodes,W,H){
  const cx=W/2,cy=H/2;
  nodes.forEach((n,i)=>{
    const p=POS[n.id];
    if(p){n.x=p.x;n.y=p.y;}
    else{const a=i/Math.max(1,nodes.length)*2*Math.PI;
      n.x=cx+Math.cos(a)*W*0.22;n.y=cy+Math.sin(a)*H*0.22;}
    if(n.self){n.x=cx;n.y=cy;}
  });
  const self=nodes.find(n=>n.self);
  for(let it=0;it<220;it++){
    for(const a of nodes){
      if(a.self)continue;
      let fx=0,fy=0;
      for(const b of nodes){
        if(a===b)continue;
        let dx=a.x-b.x,dy=a.y-b.y,d2=dx*dx+dy*dy||1;
        const rep=(a.parent&&a.parent===b.parent)?9000:24000;
        fx+=dx/d2*rep; fy+=dy/d2*rep;
      }
      const anchor=a.parent?nodes.find(n=>n.name===a.parent)||self:self;
      const want=a.parent?80:Math.min(W,H)*0.30;
      let dx=anchor.x-a.x,dy=anchor.y-a.y,d=Math.hypot(dx,dy)||1;
      const k=(d-want)*0.06;
      fx+=dx/d*k*d*0.14; fy+=dy/d*k*d*0.14;
      a.x+=Math.max(-14,Math.min(14,fx*0.02));
      a.y+=Math.max(-14,Math.min(14,fy*0.02));
      /* Kept well inside the box on every edge. The label hangs BELOW the
         node, so the bottom margin has to clear the whole two-line stack —
         nodes that drifted low had their text clipped off the canvas. */
      a.x=Math.max(80,Math.min(W-80,a.x));
      a.y=Math.max(38,Math.min(H-56,a.y));
    }
  }
  nodes.forEach(n=>POS[n.id]={x:n.x,y:n.y});
}

const linkCol=n=>n.self?"var(--fg)":n.link==="direct"?"var(--good)"
  :n.link==="relay"?"var(--warn)":"var(--dim)";
const linkText=n=>n.self?"this host":n.link==="direct"?"direct"
  :n.link==="relay"?"via "+n.relay:"offline";

function drawTailnet(tn){
  window._tn=tn;
  const svg=$("msvg"),box=svg.getBoundingClientRect();
  const W=Math.max(360,box.width|0),H=Math.max(200,box.height|0);
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`); svg.replaceChildren();
  const nodes=(tn&&tn.nodes)||[];
  if(!nodes.length){svg.append(txt(W/2-70,H/2,"nlink","tailnet data unavailable","#8494a8"));return;}
  layout(nodes,W,H);
  const self=nodes.find(n=>n.self)||nodes[0];

  const kids=nodes.filter(n=>n.parent);
  if(kids.length){
    const grp=[self,...kids];
    const x0=Math.min(...grp.map(n=>n.x))-48,x1=Math.max(...grp.map(n=>n.x))+48;
    const y0=Math.min(...grp.map(n=>n.y))-32,y1=Math.max(...grp.map(n=>n.y))+50;
    svg.append(mk("rect",{x:x0,y:y0,width:x1-x0,height:y1-y0,rx:14,class:"hull"}));
    svg.append(txt(x0+9,y0+13,"hull-l",`ON ${self.name.toUpperCase()}`));
  }

  for(const n of nodes){
    if(n.self)continue;
    const cls=n.link==="direct"?"e-direct":n.link==="relay"?"e-relay":"e-off";
    svg.append(mk("line",{x1:self.x,y1:self.y,x2:n.x,y2:n.y,class:"edge "+cls}));
  }

  for(const n of nodes){
    const col=linkCol(n), r=n.self?18:15;
    svg.append(mk("circle",{cx:n.x,cy:n.y,r,fill:"var(--card)",stroke:col,"stroke-width":2}));
    svg.append(icon(ICON[n.kind]||ICON.desktop,n.x,n.y,r*1.15,col));

    /* Name (with its lock) then link state, on two well-separated lines and
       no address — the IP belongs in the panel beside this, where there is
       room to read it. */
    const secure=!!(n.https&&n.https.https);
    const nameW=n.name.length*6.6;
    const nameX=secure?n.x+7:n.x;
    if(secure) svg.append(icon(LOCK,nameX-nameW/2-9,n.y+r+15,11,col));
    const t1=txt(nameX,n.y+r+19,"nlbl",n.name);t1.setAttribute("text-anchor","middle");
    const t2=txt(n.x,n.y+r+34,"nlink",linkText(n),col);t2.setAttribute("text-anchor","middle");
    svg.append(t1,t2);
  }

  const ctl=tn.control||{};
  let html=`<div class="dh">coordination server</div>
    <div class="drow"><div class="nm"><span class="led ${ctl.online?"ok":"bad"}"></span>headscale</div>
      <div class="dns">${esc(ctl.url||"—")}</div></div>
    <div class="dh">machines</div>`;
  for(const n of nodes){
    const secure=n.https&&n.https.https;
    const days=secure&&n.https.days!=null?`certificate ${n.https.days} days left`:"";
    html+=`<div class="drow">
      <div class="nm"><span class="led" style="background:${linkCol(n)}"></span>${esc(n.name)}
        ${secure?`<svg width="11" height="11" viewBox="0 0 24 24">
          ${LOCK.map(d=>`<path d="${d}" class="ico" stroke="${linkCol(n)}"/>`).join("")}</svg>`:""}</div>
      <div class="dns">${esc(n.dns||n.ip)}</div>
      <div class="ex">${esc(n.ip)}${days?" · "+days:""}</div></div>`;
  }
  const rl=(tn.relays||[]).map(r=>`${esc(r)} ${esc(RELAY[r]||"")}`).join(", ");
  if(rl)html+=`<div class="dh" style="margin-top:8px">relays</div><div class="ex">${rl}</div>`;
  $("tndetail").innerHTML=html;
}

/* ── alerts, logs, actions ────────────────────────────────────── */
let holdT=null;
function holdBtn(label,cls,action,note){
  const off=canControl?"":" disabled";
  const why=canControl?esc(note||""):"only from the machine itself";
  return `<button class="btn ${cls}"${off} data-act="${action}" title="${why}">
    <i></i><span>${esc(canControl?label:"on the screen only")}</span></button>`;
}
document.addEventListener("pointerdown",e=>{
  const b=e.target.closest(".btn[data-act]"); if(!b||b.disabled)return;
  const fill=b.querySelector("i");
  fill.style.transition="width 1.4s linear"; fill.style.width="100%";
  holdT=setTimeout(async()=>{
    b.querySelector("span").textContent="working…";
    await fetch("/api/do",{method:"POST",headers:{"X-Kiosk":"1","Content-Type":"application/json"},
      body:JSON.stringify({action:b.dataset.act})}).catch(()=>{});
    slowTick();
  },1400);
});
function cancelHold(){
  clearTimeout(holdT);
  document.querySelectorAll(".btn i").forEach(i=>{i.style.transition="width .2s";i.style.width="0"});
}
document.addEventListener("pointerup",cancelHold);
document.addEventListener("pointerleave",cancelHold);

function renderAlerts(d){
  const A=[];
  const add=(ic,col,title,sub)=>A.push({ic,col,title,sub});

  if(d.internet===false)add("✕","var(--bad)","No internet","can't reach the outside network");
  if(d.control&&!d.control.online)
    add("!","var(--warn)","Coordination server down","existing links keep working");
  if(d.tailnet&&d.tailnet.ok===false)
    add("!","var(--bad)","Tailnet "+esc(d.tailnet.state||"down"),"this host is off the tailnet");

  (d.fs||[]).forEach(f=>{const p=pc(f.used,f.total);
    if(p>=85)add(p>=93?"✕":"!",p>=93?"var(--bad)":"var(--warn)",
      `${f.mount} ${p.toFixed(0)}% full`,`${bytes(f.total-f.used)} left`);});

  (d.failed||[]).forEach(u=>add("✕","var(--bad)","Failed unit",esc(u)));

  (d.guests||[]).forEach(g=>{
    (g.containers||[]).forEach(c=>{
      if(c.state!=="running")add("!","var(--warn)",`${esc(c.name)} ${esc(c.state)}`,`on ${esc(g.name)}`);
      else if(c.warn)add("!","var(--warn)",`${esc(c.name)} ${esc(c.health)}`,`on ${esc(g.name)}`);
    });
  });

  (d.guests||[]).forEach(g=>{
    if(g.template)return;                 // nobody backs up a cloud-init template
    const b=g.backup;
    if(!b||!b.last){
      add("!","var(--warn)",`${esc(g.name)} has never been backed up`,
          "there is nothing to restore from");
      return;
    }
    const age=(Date.now()/1000)-b.last;
    if(b.ok===false)
      add("✕","var(--bad)",`${esc(g.name)} backup FAILED`,
          esc(String(b.status||"").slice(0,90)));
    else if(age>BK_BAD)
      add("✕","var(--bad)",`${esc(g.name)} backup is ${dur(age)} old`,
          "the nightly job has not run");
    else if(age>BK_WARN)
      add("!","var(--warn)",`${esc(g.name)} backup is ${dur(age)} old`,
          "one is expected every night");
  });

  (d.tailnet?.nodes||[]).forEach(n=>{
    if(n.https&&n.https.https&&n.https.days!=null&&n.https.days<21)
      add("!","var(--warn)",`${esc(n.name)} cert expires in ${n.https.days}d`,"");
  });

  const ups=d.updates||[];
  const sec=ups.filter(u=>u.security), reb=ups.filter(u=>u.needs_reboot);
  const rest=ups.filter(u=>!u.security&&!u.needs_reboot);

  let html=A.map(a=>`<div class="al"><span class="ic" style="color:${a.col}">${a.ic}</span>
    <span class="tx"><b>${a.title}</b><span>${a.sub||""}</span></span></div>`).join("");

  if(sec.length)html+=`<div class="al"><span class="ic" style="color:var(--good)">↑</span>
    <span class="tx"><b>${sec.length} security update${sec.length>1?"s":""}</b>
    <span>taken automatically tonight</span></span></div>`;

  if(rest.length)html+=`<div class="al"><span class="ic" style="color:var(--warn)">↑</span>
    <span class="tx"><b>${rest.length} update${rest.length>1?"s":""} waiting</b>
    <span>held back from the nightly run</span>
    ${holdBtn("hold to install","","upgrade","runs apt-get dist-upgrade")}</span></div>`;

  if(reb.length)html+=`<div class="al"><span class="ic" style="color:var(--warn)">⟳</span>
    <span class="tx"><b>${reb.length} kernel update${reb.length>1?"s":""}</b>
    <span>only takes effect after a reboot</span></span></div>`;

  if(d.reboot_required)html+=`<div class="al"><span class="ic" style="color:var(--warn)">⟳</span>
    <span class="tx"><b>Reboot pending</b>
    <span>every guest goes down with the host</span>
    ${holdBtn("hold to reboot","danger","reboot","reboots this hypervisor")}</span></div>`;

  (d.actions||[]).forEach(a=>html+=`<div class="al">
    <span class="ic" style="color:${a.ok?"var(--good)":"var(--bad)"}">${a.ok?"✓":"✕"}</span>
    <span class="tx"><b>${esc(a.name)} ${a.ok?"finished":"failed"}</b>
    <span>${esc(new Date(a.t*1000).toLocaleTimeString([],{hour12:false}))}</span></span></div>`);

  keepScroll("alist",()=>{
    $("alist").innerHTML=html||`<div class="ok-note"><span>✓</span> all healthy</div>`;});
}

function renderLogs(d){
  const rows=(d.logs||[]).map(l=>{
    const when=new Date(l.t*1000).toLocaleTimeString([],{hour12:false,hour:"2-digit",minute:"2-digit"});
    const isPve=l.source==="pve";
    const cls=isPve?(l.ok?"":"bad"):(l.status==="err"?"bad":"warn");
    const who=isPve?(l.user||"—"):(l.type||"kernel");
    const what=isPve
      ? `${esc(l.type)}${l.id?" "+esc(l.id):""} — ${esc(l.status||"running")}`
      : esc(l.msg||"")+(l.count>1?` <span style="color:var(--dim)">×${l.count}</span>`:"");
    return `<div class="lg ${cls}"><span class="tm">${when}</span>
      <span class="src">${isPve?"proxmox":"system"}</span>
      <span class="who">${esc(who)}</span>
      <span class="ms">${what}</span></div>`;
  }).join("");
  keepScroll("loglist",()=>{
    $("loglist").innerHTML=rows||`<div class="empty-note">nothing logged recently</div>`;});
}

/* ── slow panel ───────────────────────────────────────────────── */
function renderSlow(d){
  canControl=d.local!==false;
  $("nodename").textContent=d.node||"";
  guests=(d.guests||[]).map(g=>({...g,
    dns:(d.tailnet?.nodes||[]).find(n=>n.name.toLowerCase()===g.name.toLowerCase())?.dns||""}));
  paintTabs(); renderGuests();

  $("fs_rows").innerHTML=(d.fs||[]).map(f=>{
    const p=pc(f.used,f.total);
    return `<div class="fs">
      <div class="r1"><b>${esc(f.mount)}</b><span class="ty">${esc(f.type)}</span>
        <span class="pc mono">${p.toFixed(0)}%</span></div>
      <div class="trk" style="margin-top:4px"><i style="width:${p}%;background:${barCol(p,C.sto)}"></i></div>
      <div class="r2"><span>${bytes(f.used)} of ${bytes(f.total)}</span>
        <span class="dev">${esc(f.device)}</span></div></div>`;
  }).join("")||`<div class="empty-note">no filesystems</div>`;

  drawTailnet({...(d.tailnet||{}),control:d.control});
  renderAlerts(d);
  renderLogs(d);

  $("v_net").textContent=d.internet?"up":"down";
  $("l_net").className="led "+(d.internet?"ok":"bad");
  $("v_ts").textContent=d.tailnet?.ok?"running":(d.tailnet?.state||"down").toLowerCase();
  $("l_ts").className="led "+(d.tailnet?.ok?"ok":"bad");
  $("v_ctl").textContent=d.control?.online?"online":"unreachable";
  $("l_ctl").className="led "+(d.control?.online?"ok":"bad");
  $("p_boot").style.display=d.reboot_required?"":"none";
}

/* ── polling ──────────────────────────────────────────────────── */
/* The daemon still samples every second; only the asking is slower. It
   hands back everything since the sequence we last saw, so one request per
   5s still returns five points and the graphs keep their resolution. */
let lastOk=Date.now();
async function fastTick(){
  try{
    const q=lastSeq==null?"":"?since="+lastSeq;
    const r=await fetch("/api/fast"+q,{cache:"no-store"});
    if(!r.ok)return;
    const p=await r.json(); merge(p); renderFast(p); lastOk=Date.now();
  }catch(e){}
}
async function slowTick(){
  try{
    const r=await fetch("/api/slow",{cache:"no-store"});
    if(r.ok)renderSlow(await r.json());
  }catch(e){}
}
buildTabs(); paintTabs();
setInterval(fastTick,FAST); setInterval(slowTick,SLOW);
setInterval(()=>{$("stale").style.display=(Date.now()-lastOk>FAST*6)?"flex":"none";},2000);
fastTick(); slowTick();

function clock(){
  const n=new Date();
  $("clock").textContent=n.toLocaleTimeString([],{hour12:false});
  $("date").innerHTML=`<b>${n.toLocaleDateString([],{weekday:"long"})}</b> `+
    n.toLocaleDateString([],{day:"numeric",month:"long",year:"numeric"});
}
setInterval(clock,1000); clock();

window.addEventListener("keydown",e=>{
  const keys=GROUPS.map(([k])=>k);
  if("123".includes(e.key)){tab=keys[+e.key-1];paintTabs();renderGuests();}
  if(e.key==="ArrowRight"||e.key==="ArrowLeft"){
    const d=e.key==="ArrowRight"?1:-1;
    tab=keys[(keys.indexOf(tab)+d+keys.length)%keys.length];
    paintTabs();renderGuests();
  }
  if(e.key==="r"){fastTick();slowTick();}
});
window.addEventListener("resize",()=>{if(window._tn)drawTailnet(window._tn);});
</script>
</body>
