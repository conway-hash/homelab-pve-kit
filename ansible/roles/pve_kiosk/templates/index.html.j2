<!doctype html>
<!-- Managed by Ansible (pve_kiosk) — edits will be overwritten -->
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ pve_node }}</title>
<style>
:root{
  --bg:#0a0e14; --card:#111720; --card2:#0d131b; --line:#1d2733;
  --fg:#dbe4ee; --mut:#7a8899; --faint:#3d4a5a;
  --blue:#4c9aff; --green:#4ec9a5; --amber:#e0a34a; --red:#e05c5c; --violet:#9b8cff;
  --r:10px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:
    radial-gradient(1100px 620px at 78% -12%, #14202e 0%, transparent 62%),
    var(--bg);
  color:var(--fg); overflow:hidden; cursor:none;
  font:14px/1.5 "DejaVu Sans",system-ui,sans-serif;
}
.mono{font-family:"DejaVu Sans Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}

#app{height:100vh;display:grid;gap:14px;padding:14px;
     grid-template-columns:minmax(340px,.85fr) 1.5fr;
     grid-template-rows:auto auto 1fr;
     grid-template-areas:"top top" "stats mesh" "vms mesh"}
.card{background:linear-gradient(180deg,var(--card) 0%,var(--card2) 100%);
      border:1px solid var(--line);border-radius:var(--r);padding:16px 18px;
      overflow:hidden;position:relative}
.t{font-size:11px;letter-spacing:.11em;text-transform:uppercase;color:var(--mut);
   margin-bottom:14px;display:flex;align-items:center;gap:8px}
.t::after{content:"";flex:1;height:1px;background:var(--line)}

/* ── top bar ───────────────────────────────────────────────── */
#top{grid-area:top;display:flex;align-items:center;gap:16px;padding:13px 18px}
#name{font-size:22px;font-weight:600;letter-spacing:.02em}
#name em{font-style:normal;color:var(--faint);font-weight:400}
.pill{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--mut);
      background:#0c1219;border:1px solid var(--line);border-radius:99px;padding:5px 12px}
.pill b{font-weight:600;color:var(--fg)}
.led{width:7px;height:7px;border-radius:50%;background:var(--faint);flex:none}
.led.ok{background:var(--green);animation:beat 2.4s ease-in-out infinite}
.led.warn{background:var(--amber)} .led.bad{background:var(--red);animation:beat .9s ease-in-out infinite}
@keyframes beat{0%,100%{box-shadow:0 0 0 0 currentColor;opacity:1}50%{box-shadow:0 0 0 4px transparent;opacity:.55}}
#clock{margin-left:auto;font-size:24px;font-weight:600;letter-spacing:.03em}
#date{font-size:11px;color:var(--mut);text-align:right}

/* ── stat cards ────────────────────────────────────────────── */
#stats{grid-area:stats;display:grid;gap:12px;grid-template-columns:1fr 1fr}
#stats>.card{padding:13px 14px}
.s-h{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:2px}
.s-l{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut)}
.s-v{font-size:27px;font-weight:600;letter-spacing:-.01em;line-height:1.15}
.s-v small{font-size:14px;color:var(--mut);font-weight:400;margin-left:1px}
.s-sub{font-size:11px;color:var(--mut);margin-bottom:7px}
.spark{height:38px;width:100%;display:block;overflow:visible}
.track{height:4px;background:#0a0f16;border-radius:3px;overflow:hidden;margin-top:8px}
.track>i{display:block;height:100%;border-radius:3px;background:var(--blue);
         width:0;transition:width .9s cubic-bezier(.22,.7,.24,1),background .5s}
.wide{grid-column:1/-1}

/* ── machines ──────────────────────────────────────────────── */
#vms{grid-area:vms;overflow-y:auto}
.vm{padding:11px 0;border-bottom:1px solid var(--line)}
.vm:last-child{border-bottom:0}
.vm-h{display:flex;align-items:center;gap:9px;margin-bottom:8px}
.vm-n{font-weight:600}
.tag{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--mut);
     border:1px solid var(--line);border-radius:4px;padding:1px 6px}
.vm-u{margin-left:auto;font-size:11.5px;color:var(--mut)}
.vm-m{display:grid;grid-template-columns:34px 1fr 58px;gap:9px;align-items:center;
      font-size:11px;color:var(--mut);margin-top:5px}
.vm-m .track{margin:0}

/* ── mesh ──────────────────────────────────────────────────── */
#mesh{grid-area:mesh;display:flex;flex-direction:column}
#msvg{flex:1;width:100%;min-height:0}
.edge{fill:none;stroke-linecap:round}
.e-direct{stroke:var(--green);stroke-width:2;opacity:.8}
.e-relay{stroke:var(--amber);stroke-width:2;stroke-dasharray:7 6;opacity:.85;
         animation:flow 1.1s linear infinite}
@keyframes flow{to{stroke-dashoffset:-13}}
.e-off{stroke:var(--faint);stroke-width:1.2;stroke-dasharray:2 6;opacity:.55}
.e-unknown{stroke:var(--faint);stroke-width:1;stroke-dasharray:1 7;opacity:.34}
.n-ring{fill:var(--card);stroke-width:2;transition:stroke .6s}
.n-name{fill:var(--fg);font-size:12.5px;text-anchor:middle;font-weight:600}
.n-ip{fill:var(--mut);font-size:10px;text-anchor:middle}
.n-st{font-size:9.5px;text-anchor:middle}
.pulse{animation:halo 3s ease-out infinite}
@keyframes halo{0%{r:20;opacity:.5}100%{r:34;opacity:0}}

#key{border-top:1px solid var(--line);margin-top:6px;padding-top:11px;
     display:grid;grid-template-columns:1fr 1fr;gap:7px 20px;font-size:11.5px;color:var(--mut)}
#key .k{display:flex;gap:9px;align-items:flex-start}
#key svg{flex:none;margin-top:6px}
#key b{color:var(--fg);font-weight:600}
#relays{grid-column:1/-1;border-top:1px dashed var(--line);padding-top:8px;
        font-size:11px;color:var(--mut);min-height:17px}
#relays b{color:var(--amber)}

#stale{position:fixed;inset:0;background:rgba(10,14,20,.93);display:none;
       align-items:center;justify-content:center;color:var(--amber);font-size:19px}
</style>
</head>
<body>
<div id="app">
  <div id="top" class="card">
    <div id="name">…</div>
    <div class="pill"><span class="led ok" id="ctl_led"></span>control plane <b id="ctl">—</b></div>
    <div class="pill"><span class="led" id="ts_led"></span>tailnet <b id="ts">—</b></div>
    <div class="pill"><span class="led" id="up_led"></span><b id="upd">—</b></div>
    <div class="pill">uptime <b id="up">—</b></div>
    <div style="margin-left:auto;text-align:right">
      <div id="clock" class="mono">--:--:--</div><div id="date"></div>
    </div>
  </div>

  <div id="stats">
    <div class="card">
      <div class="s-h"><span class="s-l">cpu</span></div>
      <div class="s-v mono"><span id="cpu_v">0.0</span><small>%</small></div>
      <div class="s-sub" id="cpu_s">—</div>
      <svg class="spark" id="cpu_sp" preserveAspectRatio="none"></svg>
    </div>
    <div class="card">
      <div class="s-h"><span class="s-l">memory</span></div>
      <div class="s-v mono"><span id="mem_v">0.0</span><small>%</small></div>
      <div class="s-sub" id="mem_s">—</div>
      <svg class="spark" id="mem_sp" preserveAspectRatio="none"></svg>
    </div>
    <div class="card wide">
      <div class="s-h"><span class="s-l">root filesystem</span>
        <span class="s-sub mono" style="margin:0" id="disk_s">—</span></div>
      <div class="track"><i id="disk_b"></i></div>
      <div class="s-h" style="margin-top:9px">
        <span class="s-l">load average</span>
        <span class="mono" id="load" style="font-size:13px">—</span></div>
    </div>
  </div>

  <div id="vms" class="card">
    <div class="t">virtual machines &amp; containers</div>
    <div id="vmlist"></div>
  </div>

  <div id="mesh" class="card">
    <div class="t">tailnet mesh</div>
    <svg id="msvg" viewBox="0 0 640 420" preserveAspectRatio="xMidYMid meet"></svg>
    <div id="key">
      <div class="k"><svg width="26" height="3"><line x1="0" y1="1.5" x2="26" y2="1.5"
           stroke="var(--green)" stroke-width="2"/></svg>
        <span><b>direct</b> — the two machines send packets straight to each other</span></div>
      <div class="k"><svg width="26" height="3"><line x1="0" y1="1.5" x2="26" y2="1.5"
           stroke="var(--amber)" stroke-width="2" stroke-dasharray="6 5"/></svg>
        <span><b>relayed</b> — a firewall blocked the direct path, so traffic
        detours via a relay. Encrypted end-to-end either way, just slower</span></div>
      <div class="k"><svg width="26" height="3"><line x1="0" y1="1.5" x2="26" y2="1.5"
           stroke="var(--faint)" stroke-width="1" stroke-dasharray="1 6"/></svg>
        <span><b>not measured</b> — only this host's own links can be seen from here</span></div>
      <div class="k"><svg width="26" height="3"><line x1="0" y1="1.5" x2="26" y2="1.5"
           stroke="var(--faint)" stroke-width="1.2" stroke-dasharray="2 6"/></svg>
        <span><b>offline</b> — that device isn't connected right now</span></div>
      <div id="relays"></div>
    </div>
  </div>
</div>
<div id="stale">data is stale — collector not running?</div>

<script>
const REFRESH={{ kiosk_refresh_seconds }}*1000, NS="http://www.w3.org/2000/svg";
const $=i=>document.getElementById(i);

// Relay names are airport codes, which tell you nothing unless you already
// know them. Whichever ones are actually in use get spelled out below the
// legend; anything unlisted still shows its raw code.
const RELAY={ams:"Amsterdam",blr:"Bangalore",bom:"Mumbai",cdg:"Paris",den:"Denver",
 dfw:"Dallas",dub:"Dublin",fra:"Frankfurt",hel:"Helsinki",hkg:"Hong Kong",ist:"Istanbul",
 jnb:"Johannesburg",lax:"Los Angeles",lhr:"London",lis:"Lisbon",mad:"Madrid",mia:"Miami",
 mil:"Milan",muc:"Munich",nrt:"Tokyo",nue:"Nuremberg",nyc:"New York",ord:"Chicago",
 par:"Paris",prg:"Prague",sao:"São Paulo",sea:"Seattle",sfo:"San Francisco",sin:"Singapore",
 sto:"Stockholm",syd:"Sydney",tor:"Toronto",vie:"Vienna",waw:"Warsaw",zrh:"Zurich"};

const gib=b=>(b/1073741824).toFixed(1)+" GiB";
const pc=(u,t)=>(!t||t<=0)?0:Math.min(100,u/t*100);
function dur(s){s=Math.floor(s||0);const d=s/86400|0,h=s%86400/3600|0,m=s%3600/60|0;
  return d?`${d}d ${h}h`:h?`${h}h ${m}m`:`${m}m`;}
const mk=(t,a)=>{const n=document.createElementNS(NS,t);for(const k in a)n.setAttribute(k,a[k]);return n;};
const tx=(x,y,c,s,f)=>{const n=mk("text",{x,y,class:c});if(f)n.setAttribute("fill",f);n.textContent=s;return n;};

// Counting the number up instead of snapping to it: at a 10s poll a hard
// jump reads as a glitch, and the eye catches a moving digit from across
// a room where a static one just sits there.
const tween={};
function num(id,to,dp=1){
  const el=$(id), from=tween[id]??to, t0=performance.now(), D=700;
  tween[id]=to;
  (function step(t){
    const k=Math.min(1,(t-t0)/D), e=1-Math.pow(1-k,3);
    el.textContent=(from+(to-from)*e).toFixed(dp);
    if(k<1) requestAnimationFrame(step);
  })(t0);
}
const tone=p=>p>=90?"var(--red)":p>=72?"var(--amber)":"var(--blue)";

// Sparkline history lives only in the page — a rolling window of what the
// screen has seen since it loaded. Nothing is persisted; this is a wall
// display, not a metrics store.
const hist={cpu:[],mem:[]}, KEEP=70;
function spark(id,arr,col){
  const svg=$(id), W=300, H=38; svg.replaceChildren();
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`);
  if(arr.length<2) return;
  const max=Math.max(10,...arr), st=W/(KEEP-1);
  const pt=arr.map((v,i)=>[i*st,H-(v/max)*(H-4)-2]);
  const d=pt.map((p,i)=>i?`L${p[0].toFixed(1)} ${p[1].toFixed(1)}`:`M${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join("");
  const g=mk("g",{});
  const gid=id+"_g", grad=mk("linearGradient",{id:gid,x1:0,y1:0,x2:0,y2:1});
  grad.append(mk("stop",{offset:"0%","stop-color":col,"stop-opacity":".34"}),
              mk("stop",{offset:"100%","stop-color":col,"stop-opacity":"0"}));
  g.append(grad);
  g.append(mk("path",{d:`${d}L${pt.at(-1)[0]} ${H}L0 ${H}Z`,fill:`url(#${gid})`,stroke:"none"}));
  g.append(mk("path",{d,fill:"none",stroke:col,"stroke-width":1.8,"stroke-linejoin":"round"}));
  g.append(mk("circle",{cx:pt.at(-1)[0],cy:pt.at(-1)[1],r:2.6,fill:col}));
  // Slide the whole trace one step left, so the chart scrolls rather than
  // twitching a new point into existence every poll.
  g.style.transform=`translateX(${st}px)`;
  svg.append(g);
  requestAnimationFrame(()=>{g.style.transition="transform .85s linear";g.style.transform="translateX(0)";});
}

function mesh(ts){
  const svg=$("msvg"); svg.replaceChildren();
  if(!ts||!ts.Self){svg.append(tx(320,210,"n-ip","tailnet data unavailable"));return;}
  const nodes=[{p:ts.Self,me:true},...Object.values(ts.Peer||{}).map(p=>({p,me:false}))];
  const n=nodes.length, cx=320, cy=196, R=Math.min(150,74+n*17);

  // A ring, and every pair joined: this is a mesh, and no node — including
  // the one drawing it — sits at its centre.
  nodes.forEach((o,i)=>{const a=i/n*2*Math.PI-Math.PI/2;
    o.x=cx+R*Math.cos(a); o.y=cy+R*Math.sin(a);});

  const seen=new Set(), relays=new Set();
  for(let i=0;i<n;i++) for(let j=i+1;j<n;j++){
    const A=nodes[i],B=nodes[j], involvesMe=A.me||B.me;
    const other=A.me?B:B.me?A:null;
    let k="e-unknown";
    if(involvesMe){
      const p=other.p, on=p.Online;
      const relayed=on&&!!p.Relay&&!p.CurAddr;
      k=!on?"e-off":relayed?"e-relay":"e-direct";
      if(relayed){relays.add(p.Relay); seen.add(p.Relay);}
    }
    // Bow each edge away from the centre so chords don't stack into a blob.
    const mx=(A.x+B.x)/2, my=(A.y+B.y)/2;
    const qx=mx+(mx-cx)*0.17, qy=my+(my-cy)*0.17;
    svg.append(mk("path",{d:`M${A.x} ${A.y} Q${qx} ${qy} ${B.x} ${B.y}`,class:"edge "+k}));
  }

  nodes.forEach(o=>{
    const p=o.p, on=p.Online||o.me;
    const relayed=!o.me&&on&&!!p.Relay&&!p.CurAddr;
    const col=o.me?"var(--blue)":!on?"var(--faint)":relayed?"var(--amber)":"var(--green)";
    if(on) svg.append(mk("circle",{cx:o.x,cy:o.y,r:20,fill:col,opacity:".13",class:"pulse"}));
    svg.append(mk("circle",{cx:o.x,cy:o.y,r:19,class:"n-ring",stroke:col}));
    svg.append(tx(o.x,o.y+4,"n-name",(p.HostName||"?").slice(0,2).toUpperCase(),col));
    svg.append(tx(o.x,o.y+37,"n-name",(p.HostName||"?").slice(0,15)));
    svg.append(tx(o.x,o.y+50,"n-ip",(p.TailscaleIPs||[""])[0]));
    svg.append(tx(o.x,o.y+62,"n-st",
      o.me?"this host":!on?"offline":relayed?"via "+p.Relay:"direct",col));
  });

  $("relays").innerHTML = relays.size
    ? "relays in use: "+[...relays].map(r=>`<b>${r}</b> = ${RELAY[r]||"unknown location"}`).join(" · ")
    : "every link is direct right now — no relays in use";
}

function render(d){
  $("name").innerHTML = (d.node||"?")+' <em>proxmox ve</em>';

  const h=d.host;
  if(h){
    const cp=(h.cpu||0)*100, mp=pc(h.memory?.used,h.memory?.total), dp=pc(h.rootfs?.used,h.rootfs?.total);
    hist.cpu.push(cp); hist.mem.push(mp);
    if(hist.cpu.length>KEEP){hist.cpu.shift();hist.mem.shift();}
    num("cpu_v",cp); num("mem_v",mp);
    $("cpu_s").textContent=`${h.cpuinfo?.cpus||"?"} cores · ${(h.cpuinfo?.model||"").replace(/\(R\)|\(TM\)/g,"").slice(0,30)}`;
    $("mem_s").textContent=`${gib(h.memory?.used)} of ${gib(h.memory?.total)}`;
    $("disk_s").textContent=`${gib(h.rootfs?.used)} / ${gib(h.rootfs?.total)}`;
    const b=$("disk_b"); b.style.width=dp+"%"; b.style.background=tone(dp);
    $("load").textContent=(h.loadavg||[]).join("   ");
    $("up").textContent=dur(h.uptime);
    spark("cpu_sp",hist.cpu,"#4c9aff"); spark("mem_sp",hist.mem,"#9b8cff");
  }

  const rows=[...(d.guests||[]).map(g=>({...g,k:"vm"})),...(d.lxc||[]).map(g=>({...g,k:"ct"}))]
             .sort((a,b)=>a.vmid-b.vmid);
  $("vmlist").innerHTML = rows.length ? rows.map(g=>{
    const on=g.status==="running";
    const c=(g.cpu||0)*100, m=pc(g.mem,g.maxmem);
    return `<div class="vm"><div class="vm-h">
      <span class="led ${on?"ok":""}"></span><span class="vm-n">${g.name||"—"}</span>
      <span class="tag">${g.k} ${g.vmid}</span>
      <span class="vm-u">${on?dur(g.uptime):g.status}</span></div>`+
      (on?`<div class="vm-m"><span>cpu</span><div class="track"><i style="width:${c.toFixed(1)}%;background:${tone(c)}"></i></div><span class="mono">${c.toFixed(1)}%</span></div>
           <div class="vm-m"><span>mem</span><div class="track"><i style="width:${m.toFixed(1)}%;background:${tone(m)}"></i></div><span class="mono">${gib(g.mem).replace(" GiB","G")}</span></div>`:"")+
      `</div>`;
  }).join("") : `<div class="vm-u">no machines</div>`;

  const u=d.updates|0;
  $("upd").textContent = u ? u+" updates" : "up to date";
  $("up_led").className = "led "+(u?"warn":"ok");

  const c=d.control||{};
  $("ctl").textContent = c.online ? "online" : "unreachable";
  $("ctl_led").className = "led "+(c.online?"ok":"bad");

  const st=d.tailnet?.BackendState||"unknown";
  $("ts").textContent=st.toLowerCase();
  $("ts_led").className="led "+(st==="Running"?"ok":"bad");

  mesh(d.tailnet);
  $("stale").style.display=((Date.now()-new Date(d.generated).getTime())/1000>REFRESH/1000*4)?"flex":"none";
}

async function tick(){
  try{const r=await fetch("data.json?t="+Date.now(),{cache:"no-store"});if(r.ok)render(await r.json());}catch(e){}
}
function clock(){const n=new Date();
  $("clock").textContent=n.toLocaleTimeString([], {hour12:false});
  $("date").textContent=n.toLocaleDateString([], {weekday:"short",day:"numeric",month:"short"});}
setInterval(clock,1000); clock();
tick(); setInterval(tick,REFRESH);
</script>
</body>
</html>
