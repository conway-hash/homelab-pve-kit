# Managed by Ansible (pve_kiosk) — edits will be overwritten
[Unit]
Description=Start the lofi stream at {{ kiosk_lofi_start }}

[Timer]
OnCalendar=*-*-* {{ kiosk_lofi_start }}:00
# No Persistent=true: catching up on a missed 8pm start at 3am, because
# the box was off, is exactly the surprise the volume ramp exists to avoid.
Persistent=false
Unit=kiosk-lofi.service

[Install]
WantedBy=timers.target
