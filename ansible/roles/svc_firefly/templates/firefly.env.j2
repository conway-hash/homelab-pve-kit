# Managed by Ansible (svc_firefly) — edits will be overwritten.
# Mode 0600: this file holds the app key, the cron token and the DB password.

APP_ENV=production
APP_DEBUG=false

# Must match the external URL exactly. Laravel builds redirects and asset
# links from it, so a mismatch does not fail loudly — it sends you to the
# wrong host after login and reads as a broken session.
APP_URL=https://{{ firefly_domain }}
APP_KEY={{ svc_firefly_app_key }}

SITE_OWNER={{ firefly_site_owner }}
TZ={{ firefly_timezone }}

# ** is what Firefly's own documentation prescribes for a reverse proxy.
# Without it Laravel sees Caddy's address as the client, decides the request
# arrived over plain HTTP, and generates http:// URLs on an HTTPS site.
TRUSTED_PROXIES=**

# Sessions only travel over TLS here, so there is no reason to let the cookie
# be sent any other way.
COOKIE_SECURE=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD={{ svc_firefly_postgres_password }}

# Authenticates the scheduled-job endpoint the systemd timer calls.
STATIC_CRON_TOKEN={{ svc_firefly_cron_token }}
