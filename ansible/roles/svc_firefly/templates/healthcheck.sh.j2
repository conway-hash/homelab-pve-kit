#!/bin/sh
# Managed by Ansible (svc_firefly) — edits will be overwritten.
#
# Docker restarts a container whose process EXITS; it does nothing about one
# that is running and not answering. That leaves the real failure modes
# uncovered — a wedged PHP-FPM, a Caddy on a certificate it failed to renew, a
# Postgres that came back read-only — in all of which every client sees an
# outage while `docker ps` reports everything up.

set -eu

STATE=/run/firefly-healthcheck.failures
THRESHOLD={{ firefly_selfheal_failures }}

# --resolve, not a Host header: it sets SNI correctly, so Caddy picks the right
# certificate and curl genuinely verifies it. An expired certificate has to
# FAIL this check — that is one of the things it exists to catch.
#
# Not -L. An unauthenticated request is answered with a redirect to the login
# page, and that redirect IS the app being alive.
if curl -fsS --max-time 15 \
     --resolve "{{ firefly_domain }}:443:127.0.0.1" \
     "https://{{ firefly_domain }}/" >/dev/null 2>&1; then
  rm -f "$STATE"
  exit 0
fi

FAILURES=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 ))
echo "$FAILURES" > "$STATE"

if [ "$FAILURES" -lt "$THRESHOLD" ]; then
  echo "firefly did not answer ($FAILURES/$THRESHOLD) — not restarting yet"
  exit 0
fi

echo "firefly did not answer $FAILURES times in a row — restarting the stack"
rm -f "$STATE"
systemctl restart --no-block firefly.service
