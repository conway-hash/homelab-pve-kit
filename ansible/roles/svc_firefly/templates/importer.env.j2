# Managed by Ansible (svc_firefly) — edits will be overwritten.
# Mode 0600: this file holds a Firefly access token and an RSA private key.

# The app, over the stack's private network. NOT the public URL — the importer
# talks to Firefly directly and does not need to leave the machine to do it.
FIREFLY_III_URL=http://firefly:8080

# The public URL, used only for links it shows YOU. Without it, every
# "view this in Firefly III" link points at an address only the container can
# reach.
VANITY_URL=https://{{ firefly_domain }}

FIREFLY_III_ACCESS_TOKEN={{ svc_firefly_access_token }}

# ── Enable Banking ───────────────────────────────────────────────────

ENABLE_BANKING_APP_ID={{ svc_firefly_eb_app_id }}

# The key as a single base64 line — the body of the PEM with the header,
# footer and newlines stripped. The importer accepts a path, the raw PEM, or
# this; this is the only one of the three that is both a single-line env value
# and needs no file whose permissions must match whatever uid the container
# happens to run as. It rebuilds the PEM itself before signing.
ENABLE_BANKING_PRIVATE_KEY={{ svc_firefly_eb_private_key }}

# ── Behind Caddy ─────────────────────────────────────────────────────

TRUSTED_PROXIES=**

# Without this it builds http:// callback URLs on an https:// site, and the
# bank redirect comes back to a URL that does not exist.
EXPECT_SECURE_URL=true

APP_DEBUG=false
