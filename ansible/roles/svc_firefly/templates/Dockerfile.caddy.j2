# Managed by Ansible (svc_firefly) — edits will be overwritten.
#
# The official caddy image ships no DNS provider modules, so it cannot answer
# an ACME DNS-01 challenge on its own. Ready-made images that bundle the
# Cloudflare plugin exist, but putting a stranger's build in front of a
# complete record of your finances is not a trade worth making to save one
# build step. Official image plus official plugin, compiled here.

ARG CADDY_VERSION

FROM caddy:${CADDY_VERSION}-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:${CADDY_VERSION}
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
