# Managed by Ansible (svc_vaultwarden) — edits will be overwritten.
# Mode 0600: this file holds the admin token hash.
#
# An env_file rather than compose.yml's `environment:` on purpose — Compose
# interpolates '$' in that block, and the Argon2 hash below is full of them.

DOMAIN=https://{{ vaultwarden_domain }}

# The single most important line in this file. Vaultwarden ships with
# registration OPEN. On an instance anyone on the tailnet can reach, leaving
# this true means any device that joins can create itself an account on your
# vault server.
SIGNUPS_ALLOWED=false

# Invitations only, and only from the admin page.
INVITATIONS_ALLOWED={{ vaultwarden_invitations_allowed | lower }}

ADMIN_TOKEN={{ svc_vaultwarden_admin_token }}

# Behind a proxy that terminates TLS, so Vaultwarden must be told the original
# scheme — otherwise it emits http:// links in invitation and reset emails.
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=80

LOG_LEVEL={{ vaultwarden_log_level }}
