# Managed by Ansible (svc_vaultwarden) — edits will be overwritten.

services:
  vaultwarden:
    image: vaultwarden/server:{{ vaultwarden_version }}
    container_name: vaultwarden
    # Layer 2: the container's process exited. This is the one Docker actually
    # acts on — restart policies read exit codes, not healthchecks. A container
    # that is running but wedged is handled by the self-heal timer instead, not
    # here.
    restart: unless-stopped
    env_file:
      # format: raw — parsed literally, with NO variable interpolation.
      #
      # Compose interpolates $ in env_file VALUES, not just in `environment:`.
      # The admin token is an Argon2 PHC string full of $-delimited fields, so
      # the default parser ate every one of them and handed the container a
      # 59-character fragment — from a file that was correct on disk. Nothing
      # logs a warning; /admin just rejects the right password.
      - path: ./vaultwarden.env
        format: raw
    volumes:
      - ./data:/data
    # No `ports:`. Publishing 80 here would put an unauthenticated plaintext
    # Vaultwarden on the guest's LAN address, beside the TLS one, defeating the
    # entire point of the proxy in front of it.

  caddy:
    build:
      context: .
      dockerfile: Dockerfile.caddy
      args:
        CADDY_VERSION: "{{ caddy_version }}"
    container_name: vaultwarden-caddy
    restart: unless-stopped
    env_file:
      # raw here too. This token has no $ in it today, but the failure mode is
      # silent and the cost of consistency is one line.
      - path: ./caddy.env
        format: raw
    ports:
      # Bound to the tailnet address, NOT 0.0.0.0. A bare "443:443" publishes on
      # every interface this guest has — including its LAN address — which put
      # the vault in front of every device on the home network. Docker's publish
      # rules also sit in front of the host firewall, so this binding, not a
      # rule, is what actually closes it.
      - "{{ svc_vaultwarden_tailnet_ip.stdout | trim }}:443:443"
      # HTTP/3. Caddy serves it by default and Bitwarden's mobile clients will
      # use it; without the UDP mapping they fall back to TCP after a stall.
      - "{{ svc_vaultwarden_tailnet_ip.stdout | trim }}:443:443/udp"
      # Loopback as well, and load-bearing: healthcheck.sh curls
      # --resolve <domain>:443:127.0.0.1. Drop this and the self-heal check can
      # never connect, decides the vault is down, and restarts a perfectly
      # healthy stack every six minutes forever.
      - "127.0.0.1:443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./caddy-data:/data
      - ./caddy-config:/config
    depends_on:
      - vaultwarden
    # Vaultwarden's image ships its own HEALTHCHECK; this one did not, so
    # Docker reported no health for it at all — which the dashboard drew as
    # a container doing worse than its neighbour when it was doing fine.
    # A container with nothing to report is not the same as a healthy one,
    # so give it something to report.
    #
    # Caddy's admin API answers on localhost:2019 and is enabled by default.
    # It proves the process is up and holding a parsed config, which is the
    # honest scope of this check — it does not prove the vhost serves TLS.
    # wget is busybox's, already in the Alpine base image; nothing is added.
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "--timeout=3",
             "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 3
      # Long enough to cover an ACME renewal on a cold start, which blocks
      # the config from loading until the certificate is in hand.
      start_period: 60s
    # Port 80 is deliberately not published. Nothing needs it: DNS-01 means
    # there is no HTTP challenge to answer, and an HTTP-to-HTTPS redirect for a
    # host only reachable over the tailnet would be answering a request that
    # cannot arrive.
