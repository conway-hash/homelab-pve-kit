# Managed by Ansible (svc_vaultwarden) — edits will be overwritten.

{
	# Where expiry warnings go. ACME registration requires an address, and an
	# unread one means the only warning before a silent outage goes nowhere.
	email {{ vaultwarden_acme_email }}
}

{{ vaultwarden_domain }} {
	tls {
		# DNS-01, not HTTP-01. HTTP-01 needs Let's Encrypt to reach port 80 on
		# this machine from the public internet, which would mean opening the
		# vault to the world purely to renew a certificate. DNS-01 proves
		# control of the name instead, so nothing here is ever exposed.
		#
		# The name lives under the tailnet base domain, which is a real
		# subdomain of a zone in Cloudflare — so a public CA can validate it
		# even though only tailnet members can resolve or reach it.
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}

		# Public resolvers, explicitly, for the challenge only.
		#
		# The plugin works out which Cloudflare zone owns a name by walking up
		# its SOA records, and by default it asks the system resolver. On a
		# tailnet member that is MagicDNS, which answers SOA queries with
		# NOTIMP — so zone discovery fails and no TXT record is ever
		# presented. The error names the domain, not the resolver, which makes
		# it look like a Cloudflare permissions problem.
		#
		# NOT 1.1.1.1: this LAN is 1.1.1.0/24, so that address is a machine
		# down the hall rather than Cloudflare's resolver.
		resolvers {{ acme_dns_resolvers | join(' ') }}
	}

	# Vaultwarden is not published on the host at all; it is reachable only
	# across this stack's private network, from Caddy. There is no plaintext
	# port to accidentally connect to and no "it works over HTTP on the LAN"
	# path to get used by mistake.
	reverse_proxy vaultwarden:80 {
		# Add blob: to img-src, and nothing else.
		#
		# Vaultwarden hardcodes its Content-Security-Policy, and the web vault it
		# ships has moved on: once icons are cached locally it renders them from
		# blob: URLs, which that policy does not allow. The browser blocks them and
		# the vault list loses its site icons. Visible only as a CSP violation in
		# the console — nothing server-side looks wrong.
		#
		# This is cosmetic. It was first committed while chasing a vault list that
		# rendered as a black page, and it was NOT the cause of that — Dark Reader
		# was, repainting an already-dark UI into black-on-black. The CSP block is
		# real and worth fixing on its own, but do not remember it as the fix for
		# anything larger.
		#
		# Deliberately a targeted replacement rather than replacing the header: a
		# blob: URL is an object the page itself created, same-origin, so this
		# permits what the app already fetched and loosens nothing else. Every
		# other directive — default-src 'none', script-src, connect-src — stays
		# exactly as Vaultwarden set it. The same header already allows
		# object-src 'self' blob:; img-src was simply missed upstream.
		#
		# Remove once Vaultwarden's own CSP includes blob: in img-src.
		header_down Content-Security-Policy "img-src 'self' data:" "img-src 'self' data: blob:"
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
