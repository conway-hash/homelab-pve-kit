# Managed by Ansible (svc_vaultwarden) — edits will be overwritten.
#
# Layer 2 of coming back on its own. The containers' `restart: unless-stopped`
# would bring them up after a reboot without this unit at all; what the unit
# adds is a single name that Ansible's handlers and the self-heal timer can
# restart the whole stack by, and a `systemctl status` answer to "is the vault
# meant to be running".

[Unit]
Description=Vaultwarden stack (Vaultwarden + Caddy)
Requires=docker.service
# tailscaled is in the ordering because the compose file now publishes on this
# guest's tailnet address. If that interface has no address yet, Docker cannot
# bind and the containers fail to start. tailscaled restores its address from
# local state without needing to reach the coordination server, so this costs
# nothing on a cold boot with the internet down.
After=docker.service network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ vaultwarden_dir }}

# `up -d --build` rather than plain `up -d`: Caddy is built from a Dockerfile
# here, and without --build a version bump would start the previously built
# image and report success.
ExecStart=/usr/bin/docker compose up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose down

# The build can pull a Go toolchain on a cold cache.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
