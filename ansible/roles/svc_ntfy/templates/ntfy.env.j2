# Managed by Ansible (svc_ntfy) — edits will be overwritten.
# Mode 0600: this file configures who may read and write every topic.

# The public-facing URL. ntfy puts this in the links it generates and the
# Android app checks it, so it must be the name the phone actually uses — not
# the container's own address.
NTFY_BASE_URL=https://{{ ntfy_domain }}

NTFY_LISTEN_HTTP=:80

# Where the message cache and the user database live. Both are inside the
# volume so they survive a container rebuild.
NTFY_CACHE_FILE=/var/lib/ntfy/cache.db
NTFY_AUTH_FILE=/var/lib/ntfy/user.db

# ⚠️ deny-all, and this is the setting that matters most in this file.
#
# ntfy's DEFAULT is read-write for anonymous users — every topic world-readable
# and world-writable to anything that can reach the server. On a tailnet that
# still means every device you own, plus anything that ever joins. With
# deny-all, a client must authenticate and hold an explicit grant, which the
# role creates for exactly two accounts.
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# How long a message stays readable after it is sent. A buffer for a phone that
# was off or out of range, not an archive.
NTFY_CACHE_DURATION={{ ntfy_message_cache_duration }}

# Attachments are not used by anything here. Zero rather than unset, so this is
# a decision on the record instead of an accident of the default.
NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT={{ ntfy_attachment_total_size_limit }}

# Behind Caddy, so the client address ntfy sees is Caddy's. Without this every
# rate limit and every log line would be attributed to the proxy.
NTFY_BEHIND_PROXY=true
