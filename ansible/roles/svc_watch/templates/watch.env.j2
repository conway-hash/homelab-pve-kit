# Managed by Ansible (svc_watch) — edits will be overwritten.
# Mode 0600: this file holds the Proxmox token, the push credential and the
# control token.

# ── Where the hypervisor is ──
#
# By tailnet name, not by LAN address. This guest reaches the host the same way
# every other client does, so a broken tailnet shows up as an alert rather than
# as a dashboard that quietly keeps working while nothing else can.
WATCH_PVE_HOST={{ watch_pve_host }}
WATCH_PVE_NODE={{ pve_node }}
WATCH_PVE_TOKEN_ID={{ watch_pve_token_id }}
WATCH_PVE_TOKEN_SECRET={{ svc_watch_pve_token_secret }}

# ── Where alerts go ──
WATCH_NTFY_URL=https://{{ ntfy_domain }}
WATCH_NTFY_TOPIC={{ watch_ntfy_topic }}
WATCH_NTFY_USER={{ ntfy_publisher_user }}
WATCH_NTFY_PASSWORD={{ svc_watch_ntfy_password }}

# What tapping a notification opens. The whole point of the Click header: an
# alert you cannot act on from the lock screen is one you learn to swipe away.
WATCH_DASHBOARD_URL=https://{{ watch_domain }}

# ── Controls ──
#
# Empty disables them outright: watchd answers 503 and the page hides the
# buttons. See defaults/main.yml.
WATCH_CONTROL_TOKEN={{ svc_watch_control_token }}

# Probed for the header pill. The same golden-base fact the tailscale role
# joins against, so the dashboard cannot disagree with the tailnet about where
# the coordination server is.
WATCH_CONTROL_URL={{ headscale_server_url }}

# The hypervisor's local exporter — per-core CPU, temperatures, GPU, the
# tailnet, and real guest memory. Everything here degrades cleanly if it is
# unreachable: those panels go quiet, the rest of the dashboard is unaffected.
WATCH_EXPORTER_URL=http://{{ watch_pve_host }}:{{ exporter_port }}/metrics

WATCH_PORT={{ watch_port }}

# ── Sampling ──
WATCH_IDLE_SECONDS={{ watch_idle_seconds }}
WATCH_ACTIVE_GRACE_SECONDS={{ watch_active_grace_seconds }}
WATCH_MIN_SECONDS={{ watch_min_seconds }}
WATCH_HISTORY_POINTS={{ watch_history_points }}

# ── Thresholds ──
WATCH_BACKUP_WARN_HOURS={{ watch_backup_warn_hours }}
WATCH_BACKUP_BAD_HOURS={{ watch_backup_bad_hours }}
WATCH_DISK_WARN_PCT={{ watch_disk_warn_pct }}
WATCH_DISK_BAD_PCT={{ watch_disk_bad_pct }}
WATCH_CERT_WARN_DAYS={{ watch_cert_warn_days }}
WATCH_CERT_BAD_DAYS={{ watch_cert_bad_days }}

# Names checked with a TLS handshake. Derived from the service switches, so a
# service that is switched off is not alerted on for having no certificate.
WATCH_TLS_HOSTS={{ watch_tls_hosts | join(',') }}

# Guests expected to be off. Without this, one you deliberately stopped alerts
# forever and the only way to silence it is to start it again.
WATCH_IGNORE_GUESTS={{ watch_ignore_guests | join(',') }}
