# Managed by Ansible (pve_exporter) — edits will be overwritten.
# No secrets in this file; it is mode 0644 on purpose so the unit can read it.

EXPORTER_NODE={{ pve_node }}
EXPORTER_PORT={{ exporter_port }}

# ⚠️ The TAILNET address, never 0.0.0.0 and never the LAN one.
#
# This box's other interface is the bridge every guest and every device in the
# house sits on. Binding everything would publish per-core load, GPU telemetry
# and the tailnet map to anything that joined the wifi. On the tailnet, being
# able to reach it already means something — which is the same argument the
# kiosk used for the port it served on.
EXPORTER_BIND={{ pve_exporter_tailnet_ip.stdout | trim }}

# How often the cheap local reads run. /proc and /sys cost nothing, and this is
# what makes a per-core graph look like a line rather than a staircase.
EXPORTER_INTERVAL={{ exporter_interval }}

# Guest introspection forks a process inside each running guest, so it is the
# most expensive thing here and the answer changes slowly.
EXPORTER_GUEST_INTERVAL={{ exporter_guest_interval }}

# The GPU's real product name. PCI ID 1002:67df is shared by the whole
# RX 470/480/570/580/590 family, so no amount of reading sysfs can narrow it
# down — the subsystem ID gets as far as "Sapphire Nitro+ RX 570/580/590" and
# the exact model is something only you know. Empty shows what the PCI database
# says.
EXPORTER_GPU_NAME={{ exporter_gpu_name }}

# Tailnet hostnames to leave off the graph, as fnmatch patterns. CI joins as an
# ephemeral node for the length of a deploy; without this a machine called
# gh-runner-33068555390 appears on screen and is gone before anyone can ask
# what it was.
EXPORTER_TAILNET_HIDE={{ exporter_tailnet_hide | join(',') }}

# What each tailnet node physically IS, where this box cannot work it out.
# It already knows it is the server and that a peer matching one of its guests
# is a VM; Tailscale's own data separates a phone from everything else and
# stops, because a laptop, a Pi and a hypervisor all report "linux".
EXPORTER_NODE_KINDS={{ exporter_node_kinds | to_json }}
